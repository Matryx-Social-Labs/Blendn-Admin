generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum user_role {
  app_admin
  organizer
  venue_owner
  attendee
}

// NextAuth.js models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String? // hashed password for credentials
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // set when the user deletes their account; PII is scrubbed, row is kept for FK integrity
  role          user_role @default(attendee)

  // Suspension, not deletion. Deleting a host cascades their events, every
  // check-in and every chat message — destroying other people's history to
  // punish one person. Reversible; `suspended_by` mirrors the plain-String
  // pattern used by chat_group_members.banned_by, with audit_logs as the trail.
  suspended_at      DateTime? @db.Timestamptz(6)
  suspended_by      String?
  suspension_reason String?

  accounts Account[]
  sessions Session[]
  profile  profiles?

  // Event relations
  organized_events       events[]
  owned_venues           venues[]                     @relation("VenueOwner")
  org_memberships        organisation_members[]
  org_join_requests      organisation_join_requests[]
  password_resets        password_reset_tokens[]
  event_check_ins        event_check_ins[]
  match_preferences      event_match_preferences[]
  likes_sent             event_likes[]                @relation("LikesSent")
  likes_received         event_likes[]                @relation("LikesReceived")
  ratings_given          peer_ratings[]               @relation("RatingsGiven")
  ratings_received       peer_ratings[]               @relation("RatingsReceived")
  chat_messages          chat_messages[]
  chat_group_memberships chat_group_members[]
  message_reactions      message_reactions[]
  event_favorites        event_favorites[]
  event_ratings          event_ratings[]
  event_reports          event_reports[]

  // Mobile API relations
  mobile_refresh_tokens mobile_refresh_tokens[]
  user_interests        user_interests[]
  oauth_accounts        user_oauth_accounts[]
  push_tokens           push_tokens[]

  // Private messaging
  conversations_as_user1 private_conversations[] @relation("ConversationUser1")
  conversations_as_user2 private_conversations[] @relation("ConversationUser2")
  sent_private_messages  private_messages[]      @relation("PrivateMessageSender")

  // Message requests
  sent_message_requests     message_requests[] @relation("MessageRequestSender")
  received_message_requests message_requests[] @relation("MessageRequestRecipient")

  // Blocking
  blocked_users blocked_users[] @relation("BlockedByUser")
  blocked_by    blocked_users[] @relation("BlockedUser")

  // Announcements
  sent_announcements event_announcements[]

  // RSVPs
  event_rsvps event_rsvps[]

  // Moderation
  moderation_flags moderation_flags[]

  // Reporting (users/messages)
  user_reports_filed    user_reports[]    @relation("UserReportReporter")
  user_reports_received user_reports[]    @relation("UserReportReported")
  message_reports       message_reports[]
  leads_assigned        leads[]
  lead_notes            lead_notes[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application models
model profiles {
  id          String   @id
  phone       String?
  // Canonical display name — always read from here, not from User.name
  name        String?
  age         Int?
  location    String?
  bio         String?
  occupation  String?
  /// Coarse field of work — a slug from `lib/work-fields.ts`, never free text.
  ///
  /// `occupation` is "Senior Backend Engineer at Razorpay": an identity, and it
  /// stays behind the identity gate. This is the version that can be shown to a
  /// stranger in a pseudonymous room — no employer, no seniority, eighteen
  /// buckets. Suppressed in rooms below eight people, where four attributes
  /// name one person.
  work_field  String?
  education   String?
  interests   String[]
  photos      String[]
  goals       String[]
  looking_for String[]
  onboarded   Boolean  @default(false)

  /// What this person is generally open to. Overridable per event — people
  /// differ on a Tuesday and a Saturday — so this is the default, not the truth.
  intent_default connection_intent[]

  /// Anonymous unless asked. The room is pseudonymous everywhere else, and a
  /// match list that named people would be the one screen that undid it.
  ///
  /// Revealing is per event (`event_match_preferences.revealed`); this only
  /// sets what the app *suggests* there, and the suggestion is applied by a tap
  /// rather than by check-in — see `docs/API.md`.
  reveal_by_default Boolean @default(false)

  /// Collected **only** when intent includes dating, and unread otherwise. A
  /// networking user is never asked their gender — less friction, and less data
  /// held about people who had no reason to give it.
  gender        String?
  interested_in String[]
  /// The label they hold, from `lib/dating.ts`. `interested_in` is what
  /// matching actually reads; this is what the person calls themselves, and it
  /// is only *sometimes* enough to derive the other. "Straight" plus
  /// "non-binary" has no defined target set, so those combinations are asked
  /// directly and this column is stored beside an `interested_in` that did not
  /// come from it.
  orientation   String?

  /// Settings the app has always shown and never stored.
  ///
  /// There were four switches on the settings screen and no columns behind them,
  /// so hydration fell back to `true` for all four and every toggle read ON
  /// whatever the user had chosen. A switch that lies is worse than no switch.
  ///
  /// Default true because that is what the UI has been claiming, so nobody's
  /// apparent settings change on the day these start being honoured.
  push_enabled   Boolean  @default(true)
  show_online    Boolean  @default(true)
  read_receipts  Boolean  @default(true)
  /// Distinct from the GPS permission. This governs whether other attendees see
  /// how far away you are; check-in still needs a fix regardless.
  share_location Boolean  @default(true)
  // push_token and push_platform removed — use push_tokens table instead
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  user           User     @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model events {
  id                String             @id @default(uuid()) @db.Uuid
  slug              String             @unique
  title             String
  description       String
  short_description String?
  latitude          Float?
  longitude         Float?
  address           String?
  // Free text, kept deliberately: most events are at places that are not on
  // the platform, so venue_id is null and this is all there is.
  venue_name        String?
  venue_id          String?            @db.Uuid
  venue_link_status venue_link_status?
  city              String?
  state             String?
  country           String?
  postal_code       String?
  start_time        DateTime           @db.Timestamptz(6)
  end_time          DateTime           @db.Timestamptz(6)
  timezone          String
  status            event_status       @default(draft)
  visibility        visibility_type    @default(public)
  max_capacity      Int?
  /// Minimum age to check in. Null — almost every event — means no restriction.
  ///
  /// The organiser is the one who knows a club night is 18+, and no combination
  /// of what an attendee ticked can substitute for that. Enforced at check-in,
  /// which is the real door, and used to hide events from people whose stated
  /// age is below it. See `lib/age.ts`.
  min_age           Int?
  current_capacity  Int                @default(0)
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime           @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime?          @db.Timestamptz(6)
  organizer_id      String
  /// Which company is accountable. `organizer_id` still records who created
  /// it — a different question, kept for audit and for "my events".
  organizer_org_id  String?            @db.Uuid
  cover_image_url   String?
  external_link     String?
  is_featured       Boolean            @default(false)
  is_recurring      Boolean            @default(false)
  check_in_radius   Float              @default(30)
  /// Extent + buffer, superseding check_in_radius. Null falls back to
  /// latitude/longitude/check_in_radius so no existing event needs a backfill.
  /// Circle or polygon — see lib/geofence.ts for why both, and why not PostGIS.
  geofence          Json?

  // Relations
  organizer          User                       @relation(fields: [organizer_id], references: [id], onDelete: Cascade)
  details            event_details?
  check_ins          event_check_ins[]
  match_preferences  event_match_preferences[]
  likes              event_likes[]
  peer_ratings       peer_ratings[]
  chat_group         chat_groups?
  media              event_media[]
  categories         event_categories[]
  favorites          event_favorites[]
  ratings            event_ratings[]
  reports            event_reports[]
  occurrences        event_occurrences[]
  sponsored_messages event_sponsored_messages[]
  announcements      event_announcements[]
  rsvps              event_rsvps[]
  feedback           event_feedback[]
  venue              venues?                    @relation(fields: [venue_id], references: [id], onDelete: SetNull)
  organizer_org      organisations?             @relation(fields: [organizer_org_id], references: [id], onDelete: SetNull)

  @@index([latitude, longitude])
  @@index([status, start_time])
  @@index([venue_id])
  @@index([organizer_org_id])
  @@index([organizer_id])
  @@index([deleted_at])
  @@index([city])
  @@index([is_featured])
  @@index([start_time])
}

model event_details {
  id                  String   @id @default(uuid()) @db.Uuid
  event_id            String   @unique @db.Uuid
  full_description    String
  house_rules         String?
  cancellation_policy String?
  additional_info     Json?
  faq                 Json?
  accessibility_info  Json?
  covid_guidelines    String?
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
}

model categories {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  icon        String?
  parent_id   String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  parent         categories?        @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children       categories[]       @relation("CategoryHierarchy")
  events         event_categories[]
  user_interests user_interests[]

  @@index([parent_id])
}

model event_categories {
  event_id    String   @db.Uuid
  category_id String   @db.Uuid
  primary     Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  event    events     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  category categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([event_id, category_id])
  @@index([category_id])
}

model event_media {
  id            String     @id @default(uuid()) @db.Uuid
  event_id      String     @db.Uuid
  type          media_type
  url           String
  thumbnail_url String?
  title         String?
  description   String?
  order         Int        @default(0)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @default(now()) @db.Timestamptz(6)

  // Relations
  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@index([event_id, order])
}

model event_check_ins {
  id             String          @id @default(uuid()) @db.Uuid
  event_id       String          @db.Uuid
  /// Which day of the event this belongs to. Not null: every event has at
  /// least one occurrence, so there is always a right answer.
  occurrence_id  String          @db.Uuid
  /// Whether this person was working or attending.
  ///
  /// Derived server-side from organisation membership at check-in time — the
  /// client app has no idea and does not need one. Stored rather than computed
  /// on read because membership changes: someone who leaves the organisation
  /// next month should not retroactively become a guest at last month's event.
  ///
  /// Occupancy counts both (fire safety counts bodies); attendance, turn-up and
  /// new-vs-returning count guests only.
  kind           check_in_kind   @default(attendee)
  user_id        String
  status         check_in_status @default(pending)
  check_in_time  DateTime?       @db.Timestamptz(6)
  check_out_time DateTime?       @db.Timestamptz(6)
  latitude       Float?
  longitude      Float?
  device_info    Json?

  /// **Deprecated — read and written by nothing since 0.65.0.**
  ///
  /// These lived here because a check-in was once one row per event. When
  /// occurrences arrived the key became `(occurrence_id, user_id)`, so a
  /// five-day conference gave one person five rows — and both readers looked
  /// the value up with `findFirst({ event_id, user_id })`, no ordering, so
  /// which day's answer you got was whatever Postgres handed back first.
  ///
  /// `event_match_preferences` replaces them: one row per person per event,
  /// which is what "per event" always meant. Kept for one release so a rollback
  /// has something to roll back to; drop them in the release after 0.65.0.
  intent   connection_intent[]
  revealed Boolean             @default(false)

  /// Presence. See lib/presence.ts — `left_area_at` is both the state and the
  /// clock, and a ping back inside clears it, so there is no enum to drift out
  /// of sync with what the pings actually said.
  last_seen_at          DateTime? @db.Timestamptz(6)
  left_area_at          DateTime? @db.Timestamptz(6)
  departure_prompted_at DateTime? @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  event      events            @relation(fields: [event_id], references: [id], onDelete: Cascade)
  occurrence event_occurrences @relation(fields: [occurrence_id], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// One check-in per person **per occurrence**, not per event.
  ///
  /// This was `@@unique([event_id, user_id])`, which made per-day attendance
  /// unrepresentable: a five-day conference held one row per attendee, and the
  /// check-in route's upsert overwrote Monday's timestamp with Tuesday's.
  /// "Who came on Wednesday" had no answer.
  @@unique([occurrence_id, user_id])
  @@index([event_id, status])
  @@index([event_id, kind])
  /// Drives the sweeper: everyone still inside with a departure pending.
  @@index([status, left_area_at])
  @@index([occurrence_id, status])
  @@index([user_id])
  @@index([user_id, status])
}

model chat_groups {
  id              String            @id @default(uuid()) @db.Uuid
  event_id        String            @unique @db.Uuid
  type            chat_group_type   @default(event)
  name            String
  description     String?
  rules           String?
  status          chat_group_status @default(active)
  member_count    Int               @default(0)
  last_message_at DateTime?         @db.Timestamptz(6)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?         @db.Timestamptz(6)

  // Relations
  event    events               @relation(fields: [event_id], references: [id], onDelete: Cascade)
  messages chat_messages[]
  members  chat_group_members[]

  @@index([status])
}

model chat_messages {
  id                String       @id @default(uuid()) @db.Uuid
  chat_group_id     String       @db.Uuid
  user_id           String
  parent_id         String?      @db.Uuid
  type              message_type @default(text)
  content           String
  metadata          Json?
  is_edited         Boolean      @default(false)
  edited_at         DateTime?    @db.Timestamptz(6)
  is_pinned         Boolean      @default(false)
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime?    @db.Timestamptz(6)
  deleted_by        String?
  moderation_status String? // "clean" | "flagged" | "hidden"

  // Relations
  chat_group       chat_groups         @relation(fields: [chat_group_id], references: [id], onDelete: Cascade)
  user             User                @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent_message   chat_messages?      @relation("MessageReplies", fields: [parent_id], references: [id])
  replies          chat_messages[]     @relation("MessageReplies")
  reactions        message_reactions[]
  moderation_flags moderation_flags[]
  feedback         event_feedback?

  @@index([chat_group_id, created_at])
  @@index([chat_group_id, deleted_at])
  @@index([user_id])
  // Self-referencing FK for threaded replies. Unindexed, deleting a chat group
  // made Postgres scan the whole chat_messages table once per cascaded message;
  // at 500k rows that is ~2.5e10 comparisons and the delete never returns.
  @@index([parent_id])
}

model chat_group_members {
  id                       String        @id @default(uuid()) @db.Uuid
  chat_group_id            String        @db.Uuid
  user_id                  String
  role                     member_role   @default(member)
  status                   member_status @default(active)
  anonymous_name           String?
  last_read_message_id     String?       @db.Uuid
  last_allowed_at          DateTime?     @db.Timestamptz(6)
  notification_preferences Json          @default("{}")
  joined_at                DateTime      @default(now()) @db.Timestamptz(6)
  created_at               DateTime      @default(now()) @db.Timestamptz(6)
  updated_at               DateTime      @default(now()) @db.Timestamptz(6)
  banned_at                DateTime?     @db.Timestamptz(6)
  banned_by                String?

  // Relations
  chat_group chat_groups @relation(fields: [chat_group_id], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([chat_group_id, user_id])
  @@unique([chat_group_id, anonymous_name])
  @@index([user_id])
  @@index([user_id, status])
}

model message_reactions {
  id         String   @id @default(uuid()) @db.Uuid
  message_id String   @db.Uuid
  user_id    String
  emoji      String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  message chat_messages @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([message_id, user_id, emoji])
  // The unique index above serves message_id lookups but not user_id, which is
  // what a user deletion cascades on.
  @@index([user_id])
}

model event_favorites {
  id         String   @id @default(uuid()) @db.Uuid
  event_id   String   @db.Uuid
  user_id    String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
  @@index([user_id])
  @@index([event_id])
}

model event_ratings {
  id         String   @id @default(uuid()) @db.Uuid
  event_id   String   @db.Uuid
  user_id    String
  rating     Int
  review     String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
  @@index([event_id])
  @@index([user_id])
}

model event_reports {
  id          String        @id @default(uuid()) @db.Uuid
  event_id    String        @db.Uuid
  user_id     String
  reason      String
  description String?
  status      report_status @default(pending)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @default(now()) @db.Timestamptz(6)

  // Relations
  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([event_id])
  @@index([status])
  @@index([user_id])
}

/// Someone reported a person.
///
/// Read by `/dashboard/moderation/reports`, beside `moderation_flags`. The two
/// queues stay separate on purpose: a flag is the pipeline's opinion about one
/// message and always has one, whereas `moderation_flags.message_id` is NOT
/// NULL with a foreign key to `chat_messages` — so it cannot hold a report about
/// a *person*, and cannot hold one about a private message either.
model user_reports {
  id          String        @id @default(uuid()) @db.Uuid
  reporter_id String
  reported_id String
  reason      String
  description String?
  status      report_status @default(pending)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @default(now()) @db.Timestamptz(6)

  /// A `User.id`, deliberately not a foreign key — the decision has to outlive
  /// the reviewer's account. Same reasoning as `users.suspended_by`.
  reviewed_by String?
  reviewed_at DateTime? @db.Timestamptz(6)

  reporter User @relation("UserReportReporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  reported User @relation("UserReportReported", fields: [reported_id], references: [id], onDelete: Cascade)

  @@index([reported_id])
  @@index([status])
  @@index([reporter_id])
  @@index([status, created_at])
}

/// Someone reported a message, in a group room or a DM.
///
/// `message_id` has no foreign key because it points at one of two tables,
/// discriminated by `message_type`. That is why these cannot be folded into
/// `moderation_flags`, whose `message_id` is constrained to `chat_messages`.
model message_reports {
  id           String        @id @default(uuid()) @db.Uuid
  reporter_id  String
  message_id   String        @db.Uuid
  message_type String // 'group' | 'private'
  reason       String
  description  String?
  status       report_status @default(pending)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @default(now()) @db.Timestamptz(6)

  reviewed_by String?
  reviewed_at DateTime? @db.Timestamptz(6)

  reporter User @relation(fields: [reporter_id], references: [id], onDelete: Cascade)

  @@index([message_id])
  @@index([status])
  @@index([reporter_id])
  @@index([status, created_at])
}

/// One day (or session) of an event.
///
/// **Every event has at least one.** A single-evening club night has exactly
/// one and behaves as it always did; a five-day conference has five. Making it
/// total rather than optional is the point: a nullable occurrence would put a
/// null branch in every query, and — because Postgres allows unlimited NULLs in
/// a unique index — check-in uniqueness would silently evaporate for every
/// single-day event.
///
/// Replaces `recurring_events`, which was schema-only: zero rows, zero reads,
/// zero writes, and an abandoned attempt at this same concept. Adding a second
/// occurrence table beside it would have left two.
model event_occurrences {
  id           String    @id @default(uuid()) @db.Uuid
  event_id     String    @db.Uuid
  /// The local calendar day this session belongs to. What "who came on
  /// Wednesday" is actually asking.
  occurs_on    DateTime  @db.Date
  start_time   DateTime  @db.Timestamptz(6)
  end_time     DateTime  @db.Timestamptz(6)
  /// Per-day capacity, for a conference selling fewer seats on the last day.
  /// Null falls back to the event's own.
  capacity     Int?
  /// A day can be called off without cancelling the whole run.
  cancelled_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)

  event     events            @relation(fields: [event_id], references: [id], onDelete: Cascade)
  check_ins event_check_ins[]

  @@unique([event_id, occurs_on])
  @@index([event_id, start_time])
  @@index([start_time])
}

model mobile_refresh_tokens {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String
  token_hash  String    @unique
  device_info Json?
  expires_at  DateTime  @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at  DateTime? @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model user_interests {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String
  category_id String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user     User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category_id])
  @@index([category_id])
}

model user_oauth_accounts {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String
  provider    String // 'google', 'apple'
  provider_id String
  email       String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_id])
  @@index([user_id])
}

model push_tokens {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String
  token      String
  platform   String // 'ios', 'android'
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, token])
  @@index([user_id])
}

// Private Messaging
/// A private conversation, and the two things that can happen to it: identity
/// arrives, or it ends.
///
/// `conversationPair()` sorts the two ids before every write, so `user1_` and
/// `user2_` are canonical — the same person is always the same side, on every
/// column below.
///
///   ┌── matched ────────────────────────────────────────────┐
///   │  pseudonyms + blurred photos                          │
///   │  user1_revealed = user2_revealed = false              │
///   └───────────────┬───────────────────────────────────────┘
///                   │ each side reveals independently, one way
///   ┌───────────────▼───────────────────────────────────────┐
///   │  that side shows their real name and photos           │
///   └───────────────┬───────────────────────────────────────┘
///                   │ unmatch / block — either party
///   ┌───────────────▼───────────────────────────────────────┐
///   │  closed_at set. Hidden from both inboxes and pools,   │
///   │  refuses new messages, retained for moderation.       │
///   └───────────────────────────────────────────────────────┘
///                   no path back: unblock is not rematch
model private_conversations {
  id              String    @id @default(uuid()) @db.Uuid
  user1_id        String
  user2_id        String
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  last_message_at DateTime? @db.Timestamptz(6)

  /// Whether each side has shown their real name and photos to the other.
  /// Per side, not mutual: revealing is a standing offer, not a trade. Seeded
  /// true at creation for anyone already revealed in the originating room —
  /// they have nothing left to reveal to someone who saw their card. Monotonic;
  /// nothing sets these back to false, because nothing can unsee a face.
  user1_revealed Boolean @default(false)
  user2_revealed Boolean @default(false)

  /// The room pseudonym each side had when they matched, snapshotted.
  ///
  /// NOT a lookup into `chat_group_members.anonymous_name`: that is keyed to the
  /// event's chat group, this row outlives the event, and the chat lifecycle
  /// sweeper deletes old groups — so a join would go null exactly when the
  /// history matters. A pair who match at two events would also have two
  /// different pseudonyms for one conversation.
  ///
  /// Null means the conversation did not come from a match (an accepted message
  /// request), and those keep real names throughout, as they always have.
  user1_pseudonym String?
  user2_pseudonym String?

  /// Set when the other side has asked this side to reveal.
  ///
  /// A boolean rather than a table, and that shape is the feature: asking twice
  /// writes the same `true`, so it cannot nag, and there is deliberately no
  /// "declined" state — a decline would deliver a rejection, which is the one
  /// thing this product exists to remove.
  user1_reveal_requested Boolean @default(false)
  user2_reveal_requested Boolean @default(false)

  /// The event whose room this pair matched in. Nullable for message-request
  /// conversations. FK-free on purpose: `events` outlives `chat_groups`, but a
  /// hard FK would still cascade a deleted event into losing the conversation.
  origin_event_id String? @db.Uuid

  /// Null while the conversation is live.
  ///
  /// Closing is a soft mark, never a delete. The row and its messages are
  /// retained because the person most motivated to erase a conversation is the
  /// one being reported in it — `message_reports.message_id` has no foreign
  /// key, so a hard delete leaves the report standing with its evidence gone
  /// and the admin queue unable to resolve an author.
  closed_at     DateTime? @db.Timestamptz(6)
  closed_by     String?
  /// 'unmatch' | 'block'. Metadata only — NOTHING branches on this. Room,
  /// socket and push filtering read `blocked_users`, which is reversible;
  /// this column is permanent, so keying a filter on it would leave someone
  /// hidden forever after they were unblocked.
  closed_reason String?

  user1    User               @relation("ConversationUser1", fields: [user1_id], references: [id], onDelete: Cascade)
  user2    User               @relation("ConversationUser2", fields: [user2_id], references: [id], onDelete: Cascade)
  messages private_messages[]

  @@unique([user1_id, user2_id])
  @@index([user1_id])
  @@index([user2_id])
  @@index([last_message_at])
  /// Every inbox read is "my live conversations", so both sides get the
  /// partial index rather than scanning and filtering.
  @@index([user1_id, closed_at])
  @@index([user2_id, closed_at])
}

model private_messages {
  id              String      @id @default(uuid()) @db.Uuid
  conversation_id String      @db.Uuid
  sender_id       String
  message_text    String?
  media_url       String?
  media_type      media_type?
  is_read         Boolean     @default(false)
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @default(now()) @db.Timestamptz(6)

  conversation private_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User                  @relation("PrivateMessageSender", fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([sender_id])
  @@index([created_at])
}

model event_rsvps {
  id         String      @id @default(uuid()) @db.Uuid
  event_id   String      @db.Uuid
  user_id    String
  status     rsvp_status @default(going)
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  updated_at DateTime    @default(now()) @db.Timestamptz(6)

  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
  @@index([event_id])
  /// Promotion reads the oldest waitlisted person for one event.
  @@index([event_id, status, created_at])
  @@index([user_id])
}

// Enums
/// A physical place. Optional on an event and usually absent: most events are
/// at venues that are not on the platform, in which case events.venue_name
/// carries a free-text location and no venue owner has any rights.
///
/// `owner_id` null means unclaimed — the record exists (an admin created it, or
/// it was seeded) but nobody operates it yet.
model venues {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  address      String?
  city         String?
  latitude     Float?
  longitude    Float?
  capacity     Int?
  /// What kind of place this is. Nullable because venues predating this, and
  /// venues an admin adds in a hurry, should not be blocked on classifying.
  venue_type   venue_type?
  /// Extent + buffer for check-in, in the shape lib/geofence.ts understands.
  /// Events at this venue inherit it and may override per event — a rooftop
  /// event at a three-floor venue is a real case.
  geofence     Json?
  owner_id     String?
  owner_org_id String?      @db.Uuid
  claimed_at   DateTime?    @db.Timestamptz(6)
  status       venue_status @default(active)
  created_by   String?
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at   DateTime?    @db.Timestamptz(6)

  // SetNull, not Cascade: removing an owner must orphan the venue, never delete
  // a real place and every event that happened in it.
  claims    venue_claims[]
  owner     User?          @relation("VenueOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  owner_org organisations? @relation(fields: [owner_org_id], references: [id], onDelete: SetNull)
  events    events[]

  @@index([owner_id])
  @@index([owner_org_id])
  @@index([city])
  @@index([status])
}

/// A host: a company, or an individual operating as one.
///
/// Everything is an organisation, including a sole trader — a uniform shape
/// beats a user-or-org union at every call site. `kind` is what allows an
/// individual organiser to exist without a registered company: one member, no
/// GSTIN. A venue owner must be `company` with a legal name and GSTIN.
model organisations {
  id           String              @id @default(uuid()) @db.Uuid
  kind         organisation_kind   @default(individual)
  display_name String
  legal_name   String?
  /// Validated by checksum offline. There is no free official verification
  /// API — confirming a GSTIN is *registered* needs a paid provider.
  gstin        String?
  address      String?
  website      String?
  status       organisation_status @default(pending)
  verified_at  DateTime?           @db.Timestamptz(6)
  verified_by  String?
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  updated_at   DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  members       organisation_members[]
  events        events[]
  venues        venues[]
  domains       organisation_domains[]
  invites       organisation_invites[]
  join_requests organisation_join_requests[]
  onboarding    organiser_onboarding_requests[]
  venue_claims  venue_claims[]

  @@index([status])
}

/// Who may act for an organisation. Membership, not identity, is what the
/// permission resolver reads — so a colleague gets the same access as whoever
/// created a thing, and the venue survives one person leaving.
model organisation_members {
  id                 String   @id @default(uuid()) @db.Uuid
  org_id             String   @db.Uuid
  user_id            String
  role               org_role @default(staff)
  is_primary_contact Boolean  @default(false)
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  org  organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([org_id, user_id])
  @@index([user_id])
  @@index([org_id])
}

/// A domain an organisation has proved it controls.
///
/// `@@unique([domain])` is the load-bearing line: without it two organisations
/// could each verify `bygbrewski.com`, and each would then auto-accept the
/// other's staff. First to verify wins; a second claim is refused and reviewed
/// by hand.
model organisation_domains {
  id                 String               @id @default(uuid()) @db.Uuid
  org_id             String               @db.Uuid
  /// Stored lowercase, apex only — `mail.acme.com` and `ACME.com` must not be
  /// two separate claims on the same company.
  domain             String
  method             domain_verify_method @default(dns_txt)
  /// The value that must appear in the TXT record. Kept after verification so
  /// a periodic re-check can confirm the record is still there.
  verification_token String
  verified_at        DateTime?            @db.Timestamptz(6)
  verified_by        String?
  created_at         DateTime             @default(now()) @db.Timestamptz(6)

  org organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@unique([domain])
  @@index([org_id])
}

/// An outstanding invitation to join an organisation.
///
/// The token is the sensitive surface — it grants access to a company's
/// dashboard — so only its SHA-256 hash is stored. A leaked database gives an
/// attacker hashes, not usable invitations.
model organisation_invites {
  id                     String    @id @default(uuid()) @db.Uuid
  org_id                 String    @db.Uuid
  /// Lowercased. The invite is bound to this address: accepting while signed in
  /// as anyone else is refused, so a forwarded link is not a way in.
  email                  String
  role                   org_role  @default(staff)
  token_hash             String
  expires_at             DateTime  @db.Timestamptz(6)
  invited_by             String
  accepted_at            DateTime? @db.Timestamptz(6)
  revoked_at             DateTime? @db.Timestamptz(6)
  /// Non-null when the invited address is outside the org's verified domain.
  /// Required in that case, and copied into audit_logs — an org that invites
  /// outsiders can do so, but not silently.
  domain_override_reason String?
  created_at             DateTime  @default(now()) @db.Timestamptz(6)

  org organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@unique([token_hash])
  @@index([org_id])
  @@index([email])
}

/// Someone on a verified domain asking to be let in.
///
/// The org's own admin decides, not the platform: a verified domain proves the
/// company owns the domain, not that every address on it should reach the
/// dashboard.
model organisation_join_requests {
  id         String              @id @default(uuid()) @db.Uuid
  org_id     String              @db.Uuid
  user_id    String
  status     join_request_status @default(pending)
  decided_by String?
  decided_at DateTime?           @db.Timestamptz(6)
  created_at DateTime            @default(now()) @db.Timestamptz(6)

  org  organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([org_id, user_id])
  @@index([org_id])
  /// The composite unique above leads with org_id, so it cannot serve the FK
  /// check that runs on every User delete.
  @@index([user_id])
}

/// A company applying to host on Blendn, before any account exists.
///
/// Deliberately not a `User` yet — an application is not an account, and
/// creating one on submit would let anyone mint dashboard logins. The row holds
/// what was claimed; approval is what creates the org, the user, and the
/// membership.
model organiser_onboarding_requests {
  id                String            @id @default(uuid()) @db.Uuid
  kind              organisation_kind @default(company)
  display_name      String
  legal_name        String?
  gstin             String?
  website           String?
  address           String?
  city              String?
  /// The person accountable. Every organisation has a human attached.
  contact_name      String
  contact_email     String
  contact_phone     String?
  /// Which dashboard role this application is for. A venue owner must be a
  /// company; an individual organiser may be a sole trader.
  requested_role    user_role         @default(organizer)
  email_verified_at DateTime?         @db.Timestamptz(6)
  /// Set at submit from the email domain. `domain` = company address, accepted
  /// as-is. `needs_proof` = free provider, must also carry GSTIN or a website.
  tier              onboarding_tier   @default(needs_proof)
  status            onboarding_status @default(pending)
  /// Shown to the reviewer, not enforced — the reviewer decides.
  review_note       String?
  reviewed_by       String?
  reviewed_at       DateTime?         @db.Timestamptz(6)
  decline_reason    String?
  /// Set on approval, linking the application to what it produced.
  org_id            String?           @db.Uuid
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  org organisations? @relation(fields: [org_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([contact_email])
  @@index([org_id])
}

/// The token for verifying an applicant's email, before they have an account.
/// Separate from `organisation_invites` because there is no org yet.
/// A password-reset token.
///
/// Mirrors `onboarding_email_tokens`: only the SHA-256 hash is stored, it is
/// single-use, and it expires. The TTL is deliberately shorter than the
/// onboarding one — an hour rather than a day — because this token changes a
/// credential rather than confirming an address, so a link sitting in an
/// inherited mailbox is worth much more to whoever finds it.
model password_reset_tokens {
  token_hash String    @id
  user_id    String
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model onboarding_email_tokens {
  token_hash String    @id
  request_id String    @db.Uuid
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([request_id])
}

enum domain_verify_method {
  dns_txt
  email_role
}

enum join_request_status {
  pending
  approved
  declined
}

enum onboarding_tier {
  domain
  needs_proof
}

enum onboarding_status {
  pending
  email_pending
  approved
  declined
}

enum organisation_kind {
  individual
  company
}

enum organisation_status {
  pending
  verified
  suspended
}

enum org_role {
  owner
  admin
  staff
}

/// What kind of place a venue is.
///
/// There was no way to tell a restaurant from a stadium, which matters for
/// every question the product asks about a venue: what a sensible check-in
/// geofence looks like, what capacity is plausible, and what an organiser is
/// searching for. Grouped by the comments so the picker can present them in
/// sections rather than as a flat list of thirty.
/// A venue owner asserting a place is theirs.
///
/// Not data entry — owning a venue record means moderating other people's
/// events held there, so a claim is an **access request**. Nothing in the
/// evidence can be verified automatically (GSTIN is checksum-only and labelled
/// as such), so every claim is decided by a person, in the same queue shape as
/// organiser onboarding.
///
/// A claim against a venue that already has an owner is a `dispute`.
model venue_claims {
  id       String @id @default(uuid()) @db.Uuid
  venue_id String @db.Uuid
  /// The organisation that would own the venue, not the person filing.
  org_id   String @db.Uuid
  filed_by String

  status     venue_claim_status @default(pending)
  /// True when the venue already had an owner at filing time.
  is_dispute Boolean            @default(false)

  /// Checksum-validated only. The reviewer checks the registered address.
  gstin    String?
  /// Uploaded document URLs, keyed by kind (trade, fssai, liquor, photo).
  /// Free-shaped because the required set differs by venue type — a park has
  /// no FSSAI licence.
  evidence Json?

  reviewed_by   String?
  reviewed_at   DateTime? @db.Timestamptz(6)
  decision_note String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  venue venues        @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  org   organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)

  /// One live claim per org per venue. Re-filing after a decline updates the
  /// row rather than stacking duplicates in the queue.
  @@unique([venue_id, org_id])
  @@index([status])
  @@index([venue_id])
  @@index([org_id])
}

enum venue_claim_status {
  pending
  approved
  declined
}

enum venue_type {
  // Food & drink
  restaurant
  pub_bar
  brewery
  cafe
  lounge_rooftop
  // Nightlife
  nightclub
  live_music_venue
  // Events & hospitality
  banquet_hall
  convention_centre
  conference_centre
  hotel
  resort
  farmhouse
  // Sport
  stadium
  sports_complex
  gym_fitness_studio
  // Culture
  theatre
  cinema
  art_gallery
  museum
  amphitheatre
  // Community
  community_hall
  coworking
  campus
  school
  library
  religious_venue
  // Open air
  park_ground
  beach_waterfront
  terrace
  // Other
  studio
  warehouse
  retail_mall
  private_residence
  other
}

enum venue_status {
  active
  archived
}

/// How an event came to be attached to a venue. An organiser picking a claimed
/// venue links it immediately without asking; the owner finds out because it
/// appears on their dashboard, and can dispute it.
enum venue_link_status {
  auto_linked
  confirmed
  disputed
}

/// One classified chat message from an event's feedback window.
///
/// Separate table rather than columns on chat_messages: only a small subset of
/// messages are ever classified, and chat_messages is the hot table — half a
/// million rows at load-test volume — so keeping it lean matters more than
/// avoiding a join.
///
/// `corrected_*` is the organiser's override, and it is the ground truth. The
/// classifier is wrong about sarcasm often enough that correction is a designed
/// affordance rather than an escape hatch, and the corrections are worth
/// keeping for future tuning.
model event_feedback {
  id           String             @id @default(uuid()) @db.Uuid
  event_id     String             @db.Uuid
  message_id   String             @unique @db.Uuid
  sentiment    feedback_sentiment
  category     issue_category
  /// 0-1. Drives whether the UI presents this as certain or as a guess — a
  /// lexicon label and an LLM label must not look equally authoritative.
  confidence   Float
  source       feedback_source
  corrected_by String?
  corrected_at DateTime?          @db.Timestamptz(6)
  created_at   DateTime           @default(now()) @db.Timestamptz(6)

  event   events        @relation(fields: [event_id], references: [id], onDelete: Cascade)
  message chat_messages @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@index([event_id, created_at])
  @@index([event_id, category])
  @@index([event_id, sentiment])
}

enum feedback_sentiment {
  positive
  neutral
  negative
}

/// Drawn from live-event operations research rather than invented. Crowd
/// mismanagement is the largest single cause of venue incidents; queueing,
/// wayfinding and technical failures are the other recurring themes.
/// safety_conduct escalates to moderation regardless of sentiment.
enum issue_category {
  entry_queue
  crowding
  facilities
  sound_av
  staff_service
  food_drink
  wayfinding
  technical
  safety_conduct
  other
}

enum feedback_source {
  lexicon
  llm
  human
}

enum rsvp_status {
  going
  maybe
  not_going
  /// Wanted to come to a full event. Promoted to `going` in the order people
  /// joined, as seats are released.
  waitlisted
}

enum event_status {
  draft
  published
  cancelled
  completed
}

enum visibility_type {
  public
  private
  unlisted
}

enum media_type {
  image
  video
  document
}

/// Working, or attending. See `event_check_ins.kind`.
/// Why someone is in the room tonight.
///
/// Multi-select and deliberately not a partition. Splitting the match surface
/// by intent would empty both halves of a new app's already-small pool, and a
/// visible "dating" tab deters the people who came to network. Intent is shown
/// on the card and shapes the ranking; it never filters anyone out.
///
/// `just_here` is a first-class answer, not a null. Plenty of people come for
/// the event and nothing else, and making them pick a social reason would be
/// both a lie and a worse experience.

/// One person liking another, scoped to the event where they were in the room
/// together.
///
/// Event-scoped deliberately. The product is "the people who are actually here",
/// and a like is a thing you felt about someone in a particular room on a
/// particular night. Carrying it across events would turn a room into a
/// follower graph, which is a different product.
///
/// Why one person is at one event, and whether they want to be named there.
///
/// One row per person per event, which is what "per event" was always supposed
/// to mean. This lived on `event_check_ins` until 0.65.0, and stopped being
/// correct the day check-ins became per-occurrence: a five-day conference gives
/// one person five check-in rows, and both readers fetched the value with
/// `findFirst({ event_id, user_id })` — no occurrence scoping, no ordering. So
/// on any multi-day event your intent and your reveal state were whichever row
/// Postgres happened to return first. Silent, and not reliably reproducible,
/// which is the worst combination to debug.
///
/// Reveal deliberately does **not** live on the profile. Being named in a room
/// has to be something a person did in that room; `profiles.reveal_by_default`
/// is a suggestion the app offers after check-in, never a switch that names
/// someone before they answer.
model event_match_preferences {
  id       String @id @default(uuid()) @db.Uuid
  event_id String @db.Uuid
  user_id  String

  /// Empty falls back to `profiles.intent_default` — see `effectiveIntents`.
  intent   connection_intent[]
  revealed Boolean             @default(false)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// The constraint that makes the ambiguity impossible rather than unlikely.
  @@unique([event_id, user_id])
  @@index([user_id])
}

/// A mutual like is the only thing that opens a conversation, and the only
/// moment identity is exchanged — and then only if both sides chose to reveal.
model event_likes {
  id         String   @id @default(uuid()) @db.Uuid
  event_id   String   @db.Uuid
  liker_id   String
  liked_id   String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  liker User   @relation("LikesSent", fields: [liker_id], references: [id], onDelete: Cascade)
  liked User   @relation("LikesReceived", fields: [liked_id], references: [id], onDelete: Cascade)

  /// Liking twice is the same as liking once.
  @@unique([event_id, liker_id, liked_id])
  /// "Has anyone liked me back?" — the mutual check, on every like.
  @@index([event_id, liked_id])
  /// Both sides of the pair get a leading index. Deleting a User cascades here
  /// on each, and an unindexed FK makes Postgres scan the whole table per
  /// deleted row — the same shape as chat_messages.parent_id.
  @@index([liker_id])
  @@index([liked_id])
}

/// What went wrong, if anything.
///
/// Deliberately short and concrete. A free-text-only report gets written by
/// almost nobody and read by almost nobody; a list someone can tap is the
/// difference between a signal and an empty table.
enum peer_issue {
  none
  /// The catch-all for "I would rather not meet them again" without an accusation.
  uncomfortable
  /// Agreed to meet and did not turn up.
  no_show
  /// The person was materially not who their profile said.
  misrepresented
  /// Escalates immediately. Never aggregated away into a score.
  harassment
}

/// Rating someone you actually met.
///
/// Attendance and connections say a night happened. This is the only thing that
/// says whether meeting a specific stranger was a good experience — which is the
/// risk the product asks people to take, and the one thing it currently asks
/// them to take on faith.
///
/// Four rules, each load-bearing:
///
///   - **Only someone you connected with.** A mutual like, which means both
///     people opted in. Rating anyone who was merely in the room is a
///     review-bombing surface and a way to punish someone for declining.
///   - **Only after it is over.** Asked at check-out or once the event ends, so
///     it reads as reflection rather than as leverage during the night.
///   - **Never shown to the person rated.** Nobody reports discomfort honestly
///     when the person they are reporting will see it and knows who was there.
///   - **One per pair per event**, so a grudge cannot be expressed twice.
///
/// The trust signal derived from these is deliberately not stored on the user —
/// `lib/trust.ts` computes it. A denormalised reputation column is a number every
/// write path has to maintain, and `events.current_capacity` already taught this
/// codebase what happens next.
model peer_ratings {
  id         String     @id @default(uuid()) @db.Uuid
  event_id   String     @db.Uuid
  rater_id   String
  rated_id   String
  /// 1–5. The everyday signal; `issue` is the exceptional one.
  rating     Int
  issue      peer_issue @default(none)
  /// Only ever read by moderation, never rendered to another attendee.
  note       String?
  created_at DateTime   @default(now()) @db.Timestamptz(6)

  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  rater User   @relation("RatingsGiven", fields: [rater_id], references: [id], onDelete: Cascade)
  rated User   @relation("RatingsReceived", fields: [rated_id], references: [id], onDelete: Cascade)

  /// One rating per pair per event.
  @@unique([event_id, rater_id, rated_id])
  /// The trust signal reads every rating about one person.
  @@index([rated_id])
  /// Both sides get a leading index — deleting a User cascades on each.
  @@index([rater_id])
  /// The moderation queue: everything that reported something, newest first.
  @@index([issue, created_at])
}

enum connection_intent {
  dating
  networking
  friendship
  just_here
}

enum check_in_kind {
  attendee
  staff
}

enum check_in_status {
  pending
  checked_in
  checked_out
  cancelled
}

enum chat_group_type {
  event
  private
  announcement
}

enum chat_group_status {
  active
  archived
  locked
}

enum message_type {
  text
  image
  video
  system
  sponsored
  announcement
}

enum member_role {
  member
  moderator
  admin
}

enum member_status {
  active
  muted
  banned
  /// Window closed and the room archived. The row is kept rather than deleted
  /// because `anonymous_name` lives on it, and deleting it would strip the
  /// pseudonyms off every historical message — breaking the feedback digest and
  /// un-anonymising nobody, just blanking them.
  left
}

enum report_status {
  pending
  reviewed
  resolved
}

enum message_request_status {
  pending
  accepted
  declined
  blocked
}

// Sponsored chat messages (periodic, auto-sent)
model event_sponsored_messages {
  id               String    @id @default(uuid()) @db.Uuid
  event_id         String    @db.Uuid
  content          String
  interval_minutes Int       @default(30)
  is_active        Boolean   @default(false)
  last_sent_at     DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)

  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@index([event_id])
  @@index([is_active])
}

// Announcement messages (instant, sent by organiser)
model event_announcements {
  id         String   @id @default(uuid()) @db.Uuid
  event_id   String   @db.Uuid
  content    String
  sent_by    String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  event  events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [sent_by], references: [id], onDelete: Cascade)

  @@index([event_id])
  @@index([created_at])
  @@index([sent_by])
}

// Audit Logs
model audit_logs {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String?
  action      String
  resource    String
  resource_id String?
  details     Json?
  ip_address  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id])
  @@index([action])
  @@index([resource])
  @@index([created_at])
}

// Blocked Users
model blocked_users {
  id         String   @id @default(uuid()) @db.Uuid
  blocker_id String
  blocked_id String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  blocker User @relation("BlockedByUser", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedUser", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, blocked_id])
  @@index([blocker_id])
  @@index([blocked_id])
}

// Message Requests
model message_requests {
  id           String                 @id @default(uuid()) @db.Uuid
  sender_id    String
  recipient_id String
  status       message_request_status @default(pending)
  message      String?
  created_at   DateTime               @default(now()) @db.Timestamptz(6)
  updated_at   DateTime               @default(now()) @db.Timestamptz(6)
  responded_at DateTime?              @db.Timestamptz(6)

  sender    User @relation("MessageRequestSender", fields: [sender_id], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRequestRecipient", fields: [recipient_id], references: [id], onDelete: Cascade)

  @@unique([sender_id, recipient_id])
  @@index([recipient_id, status])
}

// ── Content Moderation ────────────────────────────────

enum moderation_status_type {
  pending
  approved
  rejected
}

enum moderation_source {
  auto_text
  auto_image
  auto_spam
  auto_keyword
  user_report
  manual
}

model moderation_flags {
  id            String                 @id @default(uuid()) @db.Uuid
  message_id    String                 @db.Uuid
  chat_group_id String                 @db.Uuid
  user_id       String
  source        moderation_source
  status        moderation_status_type @default(pending)
  categories    Json // e.g. {"hate": 0.92, "sexual": 0.1}
  confidence    Float
  auto_action   String? // "hidden" | "none" | "muted_user"
  reviewed_by   String?
  reviewed_at   DateTime?              @db.Timestamptz(6)
  review_notes  String?
  created_at    DateTime               @default(now()) @db.Timestamptz(6)

  message chat_messages @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([status, created_at])
  @@index([chat_group_id])
  @@index([user_id])
  @@index([message_id])
}

/// A demo request from the organiser landing page.
///
/// Not an application. Applying for an account happens at `/apply` and has its
/// own tier gate and review queue (`organiser_onboarding_requests`); this is
/// someone asking for a walkthrough. The two stay separate tables and
/// cross-reference by email — merging them would put an unvetted marketing
/// contact into a queue that grants platform access.
model leads {
  id     String      @id @default(uuid()) @db.Uuid
  type   lead_type
  status lead_status @default(new)
  source String      @default("organizers-landing")

  /// Lowercased on write. The landing page lowercases too, but this is the
  /// side that has to be right — see lib/leads.ts.
  email        String
  /// Plus-addressing stripped (sam+2@x → sam@x), for abuse counting only.
  /// Never shown, never emailed; `email` is what a human contacts.
  email_root   String
  name         String?
  organization String?
  event_types  String?
  city         String?

  user_agent String?
  ip         String? @db.Inet

  /// Idempotency, scoped to leads that are still open. `"<type>:<email>"` while
  /// the lead is open, NULL once it is finished.
  ///
  /// A permanent UNIQUE(type, email) would show a visitor who returns months
  /// later a success they never got — the same silent-drop class this endpoint
  /// exists to prevent. A *partial* unique index expresses that exactly, but
  /// Prisma cannot declare one, so it would live only in migration SQL: present
  /// in production (`migrate deploy`) and absent in CI (`db push`). The
  /// duplicate test would then pass in prod and fail in CI for a real reason.
  ///
  /// A nullable unique column gets the same semantics — Postgres unique indexes
  /// permit unlimited NULLs — and both paths create it identically.
  open_key String? @unique

  assigned_to String?
  notes       lead_notes[]

  /// When the visitor pressed submit, as reported by the caller.
  submitted_at DateTime  @db.Timestamptz(6)
  /// When the row landed here. A gap between the two is the only evidence
  /// that ingest was failing and retrying.
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)
  contacted_at DateTime? @db.Timestamptz(6)

  assignee User? @relation(fields: [assigned_to], references: [id], onDelete: SetNull)

  @@index([status, created_at(sort: Desc)])
  @@index([type, created_at(sort: Desc)])
  @@index([email])
  @@index([email_root, created_at])
  @@index([assigned_to])
}

/// Append-only. "Called, no answer" and "called again, keen" are both worth
/// keeping; a single overwritable field loses the first one.
model lead_notes {
  id         String   @id @default(uuid()) @db.Uuid
  lead_id    String   @db.Uuid
  author_id  String
  body       String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  lead   leads @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  author User  @relation(fields: [author_id], references: [id], onDelete: Cascade)

  @@index([lead_id, created_at])
  @@index([author_id])
}

/// One value today. An enum so adding a kind is a migration rather than a
/// free-text column that quietly accumulates typos.
enum lead_type {
  demo_request
}

enum lead_status {
  new
  contacted
  qualified
  converted
  archived
  spam
}
