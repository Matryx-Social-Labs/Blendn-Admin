generator client {
  provider        = "prisma-client-js"
  /// Enabled once every explicit-undefined site inside a Prisma call was
  /// converted to a conditional spread (SCRUM-53, 48 sites).
  ///
  /// 48, not the 68 first reported: that count came from a regex over all of
  /// `app/` and `lib/`, and 20 of its hits were return values, socket
  /// payloads and local variables that cannot widen a query.
  ///
  /// Prisma strips an `undefined` value rather than matching or writing
  /// nothing, which is how a scoped query silently becomes unscoped — the
  /// failure that once turned a moderation lookup cross-org. This is the only
  /// mechanical guard against that class.
  ///
  /// It is a RUNTIME check: enabling it produces no typecheck errors and a
  /// green unit suite, because every DB-touching unit test mocks `@/lib/db`.
  /// Verify against real Postgres — the integration suites are the only tests
  /// that can see it.
  previewFeatures = ["strictUndefinedChecks"]
}

datasource db {
  provider = "postgresql"
}

enum user_role {
  app_admin
  organizer
  venue_owner
  attendee
  /// A brand that buys placement. A separate value rather than reusing
  /// `organizer`, because that would hand every sponsor the ability to create
  /// events — a capability leak, not a cosmetic difference. `venue_owner`
  /// exists for the same reason.
  ///
  /// Authorization does NOT read this: grants are org-anchored via
  /// `SponsorGrant`, so a person who is staff at both an organiser and a
  /// sponsor is still authorized correctly. What this value decides is which
  /// dashboard shell they see.
  sponsor
}

// NextAuth.js models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String? // hashed password for credentials
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // set when the user deletes their account; PII is scrubbed, row is kept for FK integrity
  role          user_role @default(attendee)

  // Suspension, not deletion. Deleting a host cascades their events, every
  // check-in and every chat message — destroying other people's history to
  // punish one person. Reversible; `suspended_by` mirrors the plain-String
  // pattern used by chat_group_members.banned_by, with audit_logs as the trail.
  suspended_at      DateTime? @db.Timestamptz(6)
  suspended_by      String?
  suspension_reason String?

  accounts Account[]
  sessions Session[]
  profile  profiles?

  // Event relations
  organized_events       events[]
  owned_venues           venues[]                     @relation("VenueOwner")
  org_memberships        organisation_members[]
  org_join_requests      organisation_join_requests[]
  password_resets        password_reset_tokens[]
  event_check_ins        event_check_ins[]
  presence_sessions presence_sessions[]
  match_preferences      event_match_preferences[]
  likes_sent             event_likes[]                @relation("LikesSent")
  likes_received         event_likes[]                @relation("LikesReceived")
  ratings_given          peer_ratings[]               @relation("RatingsGiven")
  ratings_received       peer_ratings[]               @relation("RatingsReceived")
  chat_messages          chat_messages[]
  chat_group_memberships chat_group_members[]
  message_reactions      message_reactions[]
  event_favorites        event_favorites[]
  event_ratings          event_ratings[]
  event_reports          event_reports[]

  // Mobile API relations
  mobile_refresh_tokens mobile_refresh_tokens[]
  user_interests        user_interests[]
  oauth_accounts        user_oauth_accounts[]
  push_tokens           push_tokens[]
  upload_grants         upload_grants[]
  poll_votes            chat_poll_votes[]
  priced_charges        placement_charges[]     @relation("ChargePricer")
  /// The notifications centre. `onDelete: Cascade` on the far side, so account
  /// deletion takes the history with it — see `docs/API.md` on erasure.
  notifications         notifications[]

  // Private messaging
  conversations_as_user1 private_conversations[] @relation("ConversationUser1")
  conversations_as_user2 private_conversations[] @relation("ConversationUser2")
  sent_private_messages  private_messages[]      @relation("PrivateMessageSender")

  // Message requests
  sent_message_requests     message_requests[] @relation("MessageRequestSender")
  received_message_requests message_requests[] @relation("MessageRequestRecipient")

  // Blocking
  blocked_users blocked_users[] @relation("BlockedByUser")
  blocked_by    blocked_users[] @relation("BlockedUser")

  // Announcements
  sent_announcements event_announcements[]

  // RSVPs
  event_rsvps event_rsvps[]

  // Moderation
  moderation_flags moderation_flags[]

  // Reporting (users/messages)
  user_reports_filed    user_reports[]      @relation("UserReportReporter")
  user_reports_received user_reports[]      @relation("UserReportReported")
  message_reports       message_reports[]
  photo_checks          photo_checks[]
  city_demand           city_demand[]
  leads_assigned        leads[]
  lead_notes            lead_notes[]
  checkInRefusals       check_in_refusals[]

  /// This model had no index at all.
  ///
  /// The admin overview scans it five times per page load -- total users, the
  /// host count by role, three nested funnel counts, and the eight-week signup
  /// series -- on a `force-dynamic` page.
  @@index([createdAt])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Application models
model profiles {
  id            String    @id
  phone         String?
  // Canonical display name — always read from here, not from User.name
  name          String?
  /// Captured at signup and wrong the next day.
  ///
  /// Kept as the fallback for every row written before `date_of_birth` existed
  /// — a number cannot be turned back into a date, so those rows keep it until
  /// the person re-enters their birthday. Read through `ageFrom` in
  /// `lib/age.ts`, never directly.
  age           Int?
  /// The fact behind the number.
  ///
  /// An 18+ gate comparing against a stored age decays silently: someone who
  /// signs up at 17 stays 17 in this table forever, so the gate keeps refusing
  /// them a year later, and someone who typed 18 at 17 stays 18 with nothing to
  /// re-derive from. A date does not go stale.
  ///
  /// **Never returned by any route.** A birth date is materially more
  /// identifying than an age — it is a standard security-question answer and
  /// half of an identity-theft pair — so `lib/age.ts` is the only reader and
  /// callers receive a number.
  ///
  /// `@db.Date` rather than a timestamp: there is no meaningful time of day
  /// here, and storing one invites timezone drift across a birthday, which is
  /// exactly the boundary the gate turns on.
  date_of_birth DateTime? @db.Date
  location      String?
  bio           String?
  occupation    String?
  /// Coarse field of work — a slug from `lib/work-fields.ts`, never free text.
  ///
  /// `occupation` is "Senior Backend Engineer at Razorpay": an identity, and it
  /// stays behind the identity gate. This is the version that can be shown to a
  /// stranger in a pseudonymous room — no employer, no seniority, eighteen
  /// buckets. Suppressed in rooms below eight people, where four attributes
  /// name one person.
  work_field    String?
  /// What they do *within* that field — up to three curated slugs, scoped to
  /// `work_field` and prefixed with it (`design_ux_research`).
  ///
  /// Curated for the same reason `work_field` is: a free-text box here is where
  /// somebody types their employer or their exact title, which is the leak the
  /// coarse bucket above exists to prevent, reintroduced one level down.
  ///
  /// The prefix is load-bearing. `pruneExpertise` runs on every profile write
  /// and drops anything whose field no longer matches — otherwise somebody who
  /// moves from Design to Finance keeps "UX Psychology" on their card forever,
  /// under a heading that contradicts it.
  expertise     String[]
  education     String?
  interests     String[]
  photos        String[]
  /// A deliberately tiny copy of `photos[0]`, for viewers who have not earned
  /// the real one.
  ///
  /// The matched-but-unrevealed state is "pseudonyms + blurred photos" — see the
  /// diagram on `private_conversations`. This is the blurred half.
  ///
  /// **A derivative, never a filter.** Sending the real URL and blurring it in
  /// the app is undone by a proxy, a cache dump or devtools in one step; this
  /// repo shipped exactly that bug before, and `MatchScreen.tsx` still carries
  /// the comment "the anonymity was one tap deep". `createBlurDerivative` makes
  /// a 40px copy client-side and uploads it as its own object, so the detail is
  /// not there to recover.
  ///
  /// One, not an array. An unrevealed profile shows a single still — the main
  /// photo they chose — and nothing else.
  blur_photo    String?
  goals         String[]
  looking_for   String[]
  onboarded     Boolean   @default(false)

  /// What this person is generally open to. Overridable per event — people
  /// differ on a Tuesday and a Saturday — so this is the default, not the truth.
  intent_default connection_intent[]

  /// Anonymous unless asked. The room is pseudonymous everywhere else, and a
  /// match list that named people would be the one screen that undid it.
  ///
  /// Revealing is per event (`event_match_preferences.revealed`); this only
  /// sets what the app *suggests* there, and the suggestion is applied by a tap
  /// rather than by check-in — see `docs/API.md`.
  reveal_by_default Boolean @default(false)

  /// Collected **only** when intent includes dating, and unread otherwise. A
  /// networking user is never asked their gender — less friction, and less data
  /// held about people who had no reason to give it.
  gender        String?
  interested_in String[]
  /// The labels they hold, from `lib/dating.ts`. `interested_in` is what
  /// matching actually reads; these are what the person calls themselves, and
  /// they are only *sometimes* enough to derive the other. "Straight" plus
  /// "non-binary" has no defined target set, so those combinations are asked
  /// directly and this column is stored beside an `interested_in` that did not
  /// come from it.
  ///
  /// **Plural, capped at three.** People hold more than one — "queer" alongside
  /// "bisexual", "asexual" alongside a romantic orientation — and a single
  /// column made someone pick which part of themselves to omit. `interested_in`
  /// derives from the **union**: adding a label must never narrow the pool,
  /// because nobody picks a second word for themselves in order to be shown
  /// fewer people. "Prefer not to say" is exclusive, the same rule
  /// `intentsAreCoherent` applies to `just_here`.
  orientations  String[]

  /// Whether `orientations` is shown to people who can already see who you are.
  ///
  /// **Default false, and it stays false unless somebody deliberately turns it
  /// on.** Sexual orientation is special-category data under GDPR Article 9; the
  /// lawful basis for showing it is explicit consent, and a default-on switch is
  /// not consent.
  ///
  /// What it does *not* do is make the field public. Even switched on, the value
  /// only reaches callers who pass `maySeeIdentity` — a mutual match, an open
  /// conversation, or a room where the person revealed themselves. The reason is
  /// ordering: this app withholds someone's real *name and face* from any caller
  /// who has not earned them, so a field more sensitive than a name cannot be
  /// less protected than one. A public switch would make orientation more
  /// exposed than a photograph.
  ///
  /// Until this existed there was no control at all: orientation was collected,
  /// fed `deriveInterestedIn`, and was shown to nobody — which is safe but is
  /// also why nobody could signal it. The allow-list in
  /// `GET /profiles/:userId` that withholds it was written because a deny-list
  /// once leaked this exact column along with `gender`, so the exposure it now
  /// permits is deliberately the narrowest one that makes the switch mean
  /// anything.
  show_orientation Boolean @default(false)

  /// Settings the app has always shown and never stored.
  ///
  /// There were four switches on the settings screen and no columns behind them,
  /// so hydration fell back to `true` for all four and every toggle read ON
  /// whatever the user had chosen. A switch that lies is worse than no switch.
  ///
  /// Default true because that is what the UI has been claiming, so nobody's
  /// apparent settings change on the day these start being honoured.
  push_enabled   Boolean  @default(true)
  /// NOT HONOURED ANYWHERE, and checked rather than assumed: no server
  /// response exposes online status at all. The client hardcodes `online` on
  /// the chat header, so this becomes real on the client side or not at all.
  /// Until then it is a switch that does nothing — kept because the column is
  /// the right shape and deleting it would lose the settings row, but it
  /// should not be presented as working.
  show_online    Boolean  @default(true)
  /// Honoured. `lib/read-receipts.ts` owns the rule, and it is applied on both
  /// surfaces the fact leaks through: the `private:read` socket relay, and
  /// `lastMessage.isRead` in the conversation list — which IS a read receipt
  /// whenever the last message is the caller's own.
  ///
  /// It governs DISCLOSURE, never the record: a reader with this off still
  /// marks messages read and clears their own badge.
  read_receipts  Boolean  @default(true)
  /// Distinct from the GPS permission. Intended to govern whether other
  /// attendees see how far away you are; check-in still needs a fix regardless.
  /// NOT HONOURED ANYWHERE, and checked: no response discloses one user's
  /// position to another outside the event and venue context, where presence
  /// is the point and is gated separately. Same status as `show_online` —
  /// a real preference with nothing yet to gate.
  share_location Boolean  @default(true)
  // push_token and push_platform removed — use push_tokens table instead
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  user           User     @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  /// Also unindexed. The admin funnel semi-joins into this table three times
  /// per load on `profile: { onboarded: true }`, which scanned it each time.
  @@index([onboarded])
}

model events {
  id                String             @id @default(uuid()) @db.Uuid
  slug              String             @unique
  title             String
  description       String
  short_description String?
  latitude          Float?
  longitude         Float?
  address           String?
  // Free text, kept deliberately: most events are at places that are not on
  // the platform, so venue_id is null and this is all there is.
  venue_name        String?
  venue_id          String?            @db.Uuid
  venue_link_status venue_link_status?
  city              String?
  state             String?
  country           String?
  postal_code       String?
  start_time        DateTime           @db.Timestamptz(6)
  end_time          DateTime           @db.Timestamptz(6)
  timezone          String
  status            event_status       @default(draft)
  visibility        visibility_type    @default(public)
  max_capacity      Int?
  /// Minimum age to check in. Null — almost every event — means no restriction.
  ///
  /// The organiser is the one who knows a club night is 18+, and no combination
  /// of what an attendee ticked can substitute for that. Enforced at check-in,
  /// which is the real door, and used to hide events from people whose stated
  /// age is below it. See `lib/age.ts`.
  min_age           Int?
  /// How the door works, as the organiser describes it.
  ///
  /// **Informational, not enforced by us.** The same reasoning as `min_age`:
  /// the organiser is the one who knows the night is guest-list, and the door
  /// that acts on it is the venue's. Nothing here blocks an RSVP, and the app
  /// must not imply that it does — a pill reading "GUEST LIST ONLY" is us
  /// relaying a fact about the night, not a gate we are keeping.
  ///
  /// App-level gating — an approval queue, an invite list — is a genuinely
  /// different feature with a write path, a reviewer and a notification, and
  /// conflating the two would leave the interface asserting an enforcement
  /// that does not exist.
  ///
  /// `open` is the default and draws nothing; the client falls back to a
  /// computed "N SPOTS LEFT" from real remaining capacity.
  door_policy       door_policy        @default(open)
  /// NO WRITER, ANYWHERE — and it was rendered as if it were live.
  ///
  /// A stored counter doing three jobs at once: what the room holds, who is in
  /// it, and how many came. Every write path would have had to maintain it and
  /// none ever did, so it served whatever each row was seeded with — on the
  /// admin events table as "N / capacity", and in the mobile API as
  /// `currentCapacity`, beside a `checkInCount` that was correct.
  ///
  /// Both readers now count instead: `lib/attendee-counts.ts` for how many
  /// people came, `lib/occupancy.ts` for who is inside right now. Neither can
  /// drift, because neither is stored.
  ///
  /// The column stays for one release so a rollback has somewhere to land, and
  /// is dropped after. Do not add a writer.
  current_capacity  Int                @default(0)
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  updated_at        DateTime           @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime?          @db.Timestamptz(6)
  organizer_id      String
  /// When the platform added this event from a public listing, rather than its
  /// own organiser creating it. Null for everything an organiser made.
  ///
  /// This is the discriminator, and it has to be, because `organizer_org_id` is
  /// null for three different reasons: a legacy row, an event created before
  /// anything wrote the column, and a curated event awaiting a claim. Only
  /// `curated_at IS NOT NULL` separates the last from the first two — which is
  /// why "unclaimed" is not modelled as an absence.
  curated_at        DateTime?          @db.Timestamptz(6)
  /// The public listing this was taken from, kept for attribution and for the
  /// domain check when somebody claims it.
  ///
  /// Deliberately absent from `eventWriteSchema`, and that is the whole reason
  /// it is a separate column from `external_link`: an owner may edit the link
  /// they show attendees, and nobody may edit the URL their claim is verified
  /// against. A claimant who could repoint this at their own domain would be
  /// verifying themselves.
  source_url        String?
  /// When an organiser proved this curated event was theirs and took it over.
  ///
  /// `organizer_org_id` is the authority on who owns it; this records when that
  /// changed hands, which is a different question and the one a reviewer asks.
  /// Keeping it separate also means "claimed" survives an ownership transfer
  /// between organisations later.
  claimed_at        DateTime?          @db.Timestamptz(6)
  /// Which company is accountable. `organizer_id` still records who created
  /// it — a different question, kept for audit and for "my events".
  organizer_org_id  String?            @db.Uuid
  cover_image_url   String?
  external_link     String?
  is_featured       Boolean            @default(false)
  is_recurring      Boolean            @default(false)
  check_in_radius   Float              @default(30)
  /// Extent + buffer, superseding check_in_radius. Null falls back to
  /// latitude/longitude/check_in_radius so no existing event needs a backfill.
  /// Circle or polygon — see lib/geofence.ts for why both, and why not PostGIS.
  geofence          Json?

  // Relations
  organizer          User                       @relation(fields: [organizer_id], references: [id], onDelete: Cascade)
  details            event_details?
  check_ins          event_check_ins[]
  presence_sessions presence_sessions[]
  /// When the "starting soon" reminder was sent, and the reason it exists.
  ///
  /// The reminder selects events starting inside a 15-minute window, so any
  /// scheduler firing more often than that sent the same reminder again on
  /// every pass — three pushes for a five-minute cron. Claiming this column
  /// with a conditional update makes the send once-per-event and safe across
  /// replicas, without a lock or a queue.
  ///
  /// Null means not yet reminded. Never reset: an event that moves is a
  /// details-changed notification, which is a different message.
  reminded_at       DateTime?         @db.Timestamptz(6)

  event_issues      event_issues[]
  match_preferences  event_match_preferences[]
  likes              event_likes[]
  peer_ratings       peer_ratings[]
  chat_group         chat_groups?
  media              event_media[]
  categories         event_categories[]
  amenities          event_amenities[]
  favorites          event_favorites[]
  ratings            event_ratings[]
  reports            event_reports[]
  occurrences        event_occurrences[]
  sponsored_messages event_sponsored_messages[]
  announcements      event_announcements[]
  sponsors           event_sponsors[]
  rsvps              event_rsvps[]
  feedback           event_feedback[]
  venue              venues?                    @relation(fields: [venue_id], references: [id], onDelete: SetNull)
  organizer_org      organisations?             @relation(fields: [organizer_org_id], references: [id], onDelete: SetNull)
  eventClaims        event_claims[]
  checkInRefusals    check_in_refusals[]

  @@index([latitude, longitude])
  @@index([status, start_time])
  @@index([venue_id])
  @@index([organizer_org_id])
  @@index([organizer_id])
  @@index([deleted_at])
  @@index([city])
  @@index([is_featured])
  @@index([start_time])
}

model event_details {
  id                  String   @id @default(uuid()) @db.Uuid
  event_id            String   @unique @db.Uuid
  full_description    String
  house_rules         String?
  cancellation_policy String?
  additional_info     Json?
  faq                 Json?
  accessibility_info  Json?
  covid_guidelines    String?
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
}

model categories {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  icon        String?
  parent_id   String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  parent         categories?        @relation("CategoryHierarchy", fields: [parent_id], references: [id])
  children       categories[]       @relation("CategoryHierarchy")
  events         event_categories[]
  user_interests user_interests[]

  @@index([parent_id])
}

model event_categories {
  event_id    String   @db.Uuid
  category_id String   @db.Uuid
  primary     Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  event    events     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  category categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@id([event_id, category_id])
  @@index([category_id])
}

/// What an event offers — "Open Bar", "Pro Photo". A curated vocabulary.
///
/// ## Seeded, not free text
///
/// The Scene's frame (`1141:4917`) draws these as two labelled tiles. `events`
/// already has `house_rules`, which is free text and a different thing: a
/// vocabulary can be rendered as an icon, filtered on later, and translated,
/// where "open bar (from 9)" typed by one organiser and "Free drinks!!" by
/// another are two facts nothing can group. Same reasoning as `categories`,
/// and the same shape — seeded by script, no admin UI until somebody asks.
///
/// ## Retired, never deleted
///
/// `is_active = false` hides an amenity from the picker and leaves every past
/// event still saying what it actually offered. The foreign key from
/// `event_amenities` is `Restrict` for the same reason: deleting an amenity
/// that events reference would rewrite history rather than end a listing.
model amenities {
  id         String   @id @default(uuid()) @db.Uuid
  /// The label as drawn — "Open Bar".
  name       String
  slug       String   @unique
  /// The second line on the tile — "Premium Spirits". Optional: not every
  /// amenity has a useful qualifier, and an invented one is worse than none.
  subtitle   String?
  /// A Material Symbols name, so the client does not carry its own mapping
  /// from slug to glyph and drift from the seed.
  icon       String?
  /// Ordering in the picker and on the card. Explicit, because alphabetical
  /// puts "Accessible Entrance" above "Open Bar" on every event in the app.
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  events event_amenities[]

  @@index([is_active, sort_order])
}

/// What the **organiser** asserted this event offers.
///
/// ## The event stores its own rows, and never reads through to the venue
///
/// A venue editing its list next month cannot change what last month's event
/// claimed, and an organiser who unticks "Open Bar" is believed. The venue
/// layer — a venue's own amenity list, used to pre-tick this one — is
/// deliberately **not** built yet: an unowned venue has no list to suggest
/// from, and today almost no venue is owned, so it would be a permission
/// system and a picker that did nothing. `docs/AMENITIES.md` carries the plan
/// for when venue ownership is dense enough to make it worth having.
model event_amenities {
  event_id   String   @db.Uuid
  amenity_id String   @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)

  event   events    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  /// `Restrict`, not `Cascade` — see `amenities`. Retirement is `is_active`.
  amenity amenities @relation(fields: [amenity_id], references: [id], onDelete: Restrict)

  @@id([event_id, amenity_id])
  @@index([amenity_id])
}

model event_media {
  id            String     @id @default(uuid()) @db.Uuid
  event_id      String     @db.Uuid
  type          media_type
  url           String
  thumbnail_url String?
  title         String?
  description   String?
  order         Int        @default(0)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @default(now()) @db.Timestamptz(6)

  // Relations
  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)

  @@index([event_id, order])
}

model event_check_ins {
  id             String          @id @default(uuid()) @db.Uuid
  event_id       String          @db.Uuid
  /// Which day of the event this belongs to. Not null: every event has at
  /// least one occurrence, so there is always a right answer.
  occurrence_id  String          @db.Uuid
  /// Whether this person was working or attending.
  ///
  /// Derived server-side from organisation membership at check-in time — the
  /// client app has no idea and does not need one. Stored rather than computed
  /// on read because membership changes: someone who leaves the organisation
  /// next month should not retroactively become a guest at last month's event.
  ///
  /// Occupancy counts both (fire safety counts bodies); attendance, turn-up and
  /// new-vs-returning count guests only.
  kind           check_in_kind   @default(attendee)
  user_id        String
  status         check_in_status @default(pending)
  check_in_time  DateTime?       @db.Timestamptz(6)
  check_out_time DateTime?       @db.Timestamptz(6)
  latitude       Float?
  longitude      Float?
  device_info    Json?

  /// Presence. See lib/presence.ts — `left_area_at` is both the state and the
  /// clock, and a ping back inside clears it, so there is no enum to drift out
  /// of sync with what the pings actually said.
  last_seen_at          DateTime? @db.Timestamptz(6)
  left_area_at          DateTime? @db.Timestamptz(6)
  departure_prompted_at DateTime? @db.Timestamptz(6)

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  event      events            @relation(fields: [event_id], references: [id], onDelete: Cascade)
  occurrence event_occurrences @relation(fields: [occurrence_id], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// One check-in per person **per occurrence**, not per event.
  ///
  /// This was `@@unique([event_id, user_id])`, which made per-day attendance
  /// unrepresentable: a five-day conference held one row per attendee, and the
  /// check-in route's upsert overwrote Monday's timestamp with Tuesday's.
  /// "Who came on Wednesday" had no answer.
  @@unique([occurrence_id, user_id])
  @@index([event_id, status])
  @@index([event_id, kind])
  /// The 5-second live-ops tick asks two questions this serves: how many
  /// arrived in the last ten minutes, and the arrival histogram. Both scanned
  /// every check-in for the event, twelve times a minute, per watched event.
  /// `lib/live-snapshot.ts` claimed "the queries are all indexed"; these two
  /// were not.
  @@index([event_id, check_in_time])
  /// Drives the sweeper: everyone still inside with a departure pending.
  @@index([status, left_area_at])
  @@index([occurrence_id, status])
  @@index([user_id])
  @@index([user_id, status])
}

model chat_groups {
  id              String            @id @default(uuid()) @db.Uuid
  event_id        String            @unique @db.Uuid
  type            chat_group_type   @default(event)
  name            String
  description     String?
  rules           String?
  status          chat_group_status @default(active)
  member_count    Int               @default(0)
  last_message_at DateTime?         @db.Timestamptz(6)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?         @db.Timestamptz(6)

  // Relations
  event    events               @relation(fields: [event_id], references: [id], onDelete: Cascade)
  messages chat_messages[]
  members  chat_group_members[]

  @@index([status])
}

model chat_messages {
  id                String       @id @default(uuid()) @db.Uuid
  chat_group_id     String       @db.Uuid
  user_id           String
  parent_id         String?      @db.Uuid
  type              message_type @default(text)
  content           String
  metadata          Json?
  is_edited         Boolean      @default(false)
  edited_at         DateTime?    @db.Timestamptz(6)
  is_pinned         Boolean      @default(false)
  created_at        DateTime     @default(now()) @db.Timestamptz(6)
  updated_at        DateTime     @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime?    @db.Timestamptz(6)
  deleted_by        String?
  moderation_status String? // "clean" | "flagged" | "hidden"

  // Relations
  chat_group       chat_groups               @relation(fields: [chat_group_id], references: [id], onDelete: Cascade)
  user             User                      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent_message   chat_messages?            @relation("MessageReplies", fields: [parent_id], references: [id])
  replies          chat_messages[]           @relation("MessageReplies")
  reactions        message_reactions[]
  moderation_flags moderation_flags[]
  feedback         event_feedback?
  poll             chat_polls?
  sponsored_sends  sponsored_message_sends[]

  @@index([chat_group_id, created_at])
  @@index([chat_group_id, deleted_at])
  @@index([user_id])
  // Self-referencing FK for threaded replies. Unindexed, deleting a chat group
  // made Postgres scan the whole chat_messages table once per cascaded message;
  // at 500k rows that is ~2.5e10 comparisons and the delete never returns.
  @@index([parent_id])
}

model chat_group_members {
  id                       String        @id @default(uuid()) @db.Uuid
  chat_group_id            String        @db.Uuid
  user_id                  String
  role                     member_role   @default(member)
  status                   member_status @default(active)
  anonymous_name           String?
  last_read_message_id     String?       @db.Uuid
  last_allowed_at          DateTime?     @db.Timestamptz(6)
  notification_preferences Json          @default("{}")
  joined_at                DateTime      @default(now()) @db.Timestamptz(6)
  created_at               DateTime      @default(now()) @db.Timestamptz(6)
  updated_at               DateTime      @default(now()) @db.Timestamptz(6)
  banned_at                DateTime?     @db.Timestamptz(6)
  banned_by                String?
  /// When the current mute was applied. Null when not muted.
  muted_at                 DateTime?     @db.Timestamptz(6)
  /// Who muted them. **Null means the mute was automatic**, and that is the
  /// whole point of the column: `checkAndAutoUnmute` cleared any `muted` status
  /// from anyone with fewer than three recent auto-hide flags, and an
  /// organiser-applied mute has zero — so `0 < 3` was true and the mute
  /// evaporated on the muted person's next message. The identical bug was found
  /// and fixed for bans, which is why `banned_by` above already exists.
  muted_by                 String?

  // Relations
  chat_group chat_groups @relation(fields: [chat_group_id], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([chat_group_id, user_id])
  @@unique([chat_group_id, anonymous_name])
  @@index([user_id])
  @@index([user_id, status])
}

model message_reactions {
  id         String   @id @default(uuid()) @db.Uuid
  message_id String   @db.Uuid
  user_id    String
  emoji      String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  message chat_messages @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([message_id, user_id, emoji])
  // The unique index above serves message_id lookups but not user_id, which is
  // what a user deletion cascades on.
  @@index([user_id])
}

model event_favorites {
  id         String   @id @default(uuid()) @db.Uuid
  event_id   String   @db.Uuid
  user_id    String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
  @@index([user_id])
  @@index([event_id])
}

model event_ratings {
  id         String   @id @default(uuid()) @db.Uuid
  event_id   String   @db.Uuid
  user_id    String
  rating     Int
  review     String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
  @@index([event_id])
  @@index([user_id])
}

model event_reports {
  id          String        @id @default(uuid()) @db.Uuid
  event_id    String        @db.Uuid
  user_id     String
  reason      String
  description String?
  status      report_status @default(pending)
  /// Who looked, and when. `user_reports` and `message_reports` have carried
  /// these since the reports queue was built; this table did not, because it
  /// had no queue — it had no writer and no reader at all. A report resolved
  /// with no record of who resolved it is the question that gets asked six
  /// weeks later and cannot be answered.
  reviewed_by String?
  reviewed_at DateTime?     @db.Timestamptz(6)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @default(now()) @db.Timestamptz(6)

  // Relations
  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([event_id])
  @@index([status])
  @@index([user_id])
}

/// Someone reported a person.
///
/// Read by `/dashboard/moderation/reports`, beside `moderation_flags`. The two
/// queues stay separate on purpose: a flag is the pipeline's opinion about one
/// message and always has one, whereas `moderation_flags.message_id` is NOT
/// NULL with a foreign key to `chat_messages` — so it cannot hold a report about
/// a *person*, and cannot hold one about a private message either.
model user_reports {
  id          String        @id @default(uuid()) @db.Uuid
  reporter_id String
  reported_id String
  reason      String
  description String?
  status      report_status @default(pending)
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  updated_at  DateTime      @default(now()) @db.Timestamptz(6)

  /// A `User.id`, deliberately not a foreign key — the decision has to outlive
  /// the reviewer's account. Same reasoning as `users.suspended_by`.
  reviewed_by String?
  reviewed_at DateTime? @db.Timestamptz(6)

  reporter User @relation("UserReportReporter", fields: [reporter_id], references: [id], onDelete: Cascade)
  reported User @relation("UserReportReported", fields: [reported_id], references: [id], onDelete: Cascade)

  @@index([reported_id])
  @@index([status])
  @@index([reporter_id])
  @@index([status, created_at])
}

/// Someone reported a message, in a group room or a DM.
///
/// `message_id` has no foreign key because it points at one of two tables,
/// discriminated by `message_type`. That is why these cannot be folded into
/// `moderation_flags`, whose `message_id` is constrained to `chat_messages`.
model message_reports {
  id           String        @id @default(uuid()) @db.Uuid
  reporter_id  String
  message_id   String        @db.Uuid
  message_type String // 'group' | 'private'
  reason       String
  description  String?
  status       report_status @default(pending)
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @default(now()) @db.Timestamptz(6)

  reviewed_by String?
  reviewed_at DateTime? @db.Timestamptz(6)

  reporter User @relation(fields: [reporter_id], references: [id], onDelete: Cascade)

  @@index([message_id])
  @@index([status])
  @@index([reporter_id])
  @@index([status, created_at])
}

/// One day (or session) of an event.
///
/// **Every event has at least one.** A single-evening club night has exactly
/// one and behaves as it always did; a five-day conference has five. Making it
/// total rather than optional is the point: a nullable occurrence would put a
/// null branch in every query, and — because Postgres allows unlimited NULLs in
/// a unique index — check-in uniqueness would silently evaporate for every
/// single-day event.
///
/// Replaces `recurring_events`, which was schema-only: zero rows, zero reads,
/// zero writes, and an abandoned attempt at this same concept. Adding a second
/// occurrence table beside it would have left two.
model event_occurrences {
  id           String    @id @default(uuid()) @db.Uuid
  event_id     String    @db.Uuid
  /// The local calendar day this session belongs to. What "who came on
  /// Wednesday" is actually asking.
  occurs_on    DateTime  @db.Date
  start_time   DateTime  @db.Timestamptz(6)
  end_time     DateTime  @db.Timestamptz(6)
  /// Per-day capacity, for a conference selling fewer seats on the last day.
  /// Null falls back to the event's own.
  capacity     Int?
  /// A day can be called off without cancelling the whole run.
  cancelled_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)

  event     events            @relation(fields: [event_id], references: [id], onDelete: Cascade)
  check_ins event_check_ins[]
  presence_sessions presence_sessions[]

  @@unique([event_id, occurs_on])
  @@index([event_id, start_time])
  @@index([start_time])
}

model mobile_refresh_tokens {
  id          String    @id @default(uuid()) @db.Uuid
  user_id     String
  token_hash  String    @unique
  device_info Json?
  expires_at  DateTime  @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at  DateTime? @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
}

model user_interests {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String
  category_id String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user     User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category categories @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category_id])
  @@index([category_id])
}

model user_oauth_accounts {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String
  provider    String // 'google', 'apple'
  provider_id String
  email       String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_id])
  @@index([user_id])
}

model push_tokens {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String
  token      String
  platform   String // 'ios', 'android'
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, token])
  @@index([user_id])
}

/// What a notification is *about*. Mirrors `NotificationData["type"]` in
/// `lib/push-notifications.ts` exactly — the union that already labels every
/// push this product sends. `__tests__/notifications.test.ts` fails if the two
/// lists ever stop agreeing, because a kind the sender emits and the enum does
/// not accept is a write that throws inside a fire-and-forget `.catch(() => {})`
/// and disappears.
enum notification_kind {
  private_message
  group_message
  event_checkin
  event_update
  announcement
  message_request
  message_request_response
  waitlist_promoted
  match
  reveal_request
  reveal
}

/// One line in the notifications centre — the bell in The Pulse's top bar.
///
/// ## Why this is written by the push sender rather than by each feature
///
/// Every per-user notification in this product already funnels through
/// `sendPushNotification`, which is the one place that knows the title, the
/// body and the deep link. Eleven `notify*` helpers sit on top of it. Writing
/// the row there means the centre is complete by construction; writing it at
/// each call site means the centre is complete until somebody adds a twelfth.
///
/// ## It is written even when no push goes out
///
/// The row is inserted **before** the token lookup, so it survives all three
/// ways a push does not arrive: notifications turned off in settings, no device
/// registered yet, and an expired token. That is the whole point of a centre —
/// it is where you look for what you missed, and "you missed it because your
/// phone was off" is exactly the case it has to cover.
///
/// ## No body-level identity
///
/// `title` and `body` are stored as sent. The reveal gate already applies to
/// push titles (`maySeeIdentity` — see `lib/push-notifications.ts`), so a
/// pseudonymous match is pseudonymous here too. This table must never be given
/// a "richer" copy of the same event, because that would route around a gate
/// that took three PRs to close.
model notifications {
  id      String            @id @default(uuid()) @db.Uuid
  user_id String
  kind    notification_kind
  title   String
  body    String
  /// Where tapping it goes — the same `data` payload the push carries, so the
  /// app has one deep-link switch rather than two that can disagree.
  data    Json?

  /// Null until it is read. A timestamp rather than a boolean because "when did
  /// they see this" is the question the retention report will ask, and turning a
  /// boolean back into a time is not possible.
  read_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // The feed: one person's notifications, newest first.
  @@index([user_id, created_at])
  // The unread count, which the bell asks for on every screen.
  @@index([user_id, read_at])
}

// Private Messaging
/// A private conversation, and the two things that can happen to it: identity
/// arrives, or it ends.
///
/// `conversationPair()` sorts the two ids before every write, so `user1_` and
/// `user2_` are canonical — the same person is always the same side, on every
/// column below.
///
///   ┌── matched ────────────────────────────────────────────┐
///   │  pseudonyms + blurred photos                          │
///   │  user1_revealed = user2_revealed = false              │
///   └───────────────┬───────────────────────────────────────┘
///                   │ each side reveals independently, one way
///   ┌───────────────▼───────────────────────────────────────┐
///   │  that side shows their real name and photos           │
///   └───────────────┬───────────────────────────────────────┘
///                   │ unmatch / block — either party
///   ┌───────────────▼───────────────────────────────────────┐
///   │  closed_at set. Hidden from both inboxes and pools,   │
///   │  refuses new messages, retained for moderation.       │
///   └───────────────────────────────────────────────────────┘
///                   no path back: unblock is not rematch
model private_conversations {
  id              String    @id @default(uuid()) @db.Uuid
  user1_id        String
  user2_id        String
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)
  last_message_at DateTime? @db.Timestamptz(6)

  /// Whether each side has shown their real name and photos to the other.
  /// Per side, not mutual: revealing is a standing offer, not a trade. Seeded
  /// true at creation for anyone already revealed in the originating room —
  /// they have nothing left to reveal to someone who saw their card. Monotonic;
  /// nothing sets these back to false, because nothing can unsee a face.
  user1_revealed Boolean @default(false)
  user2_revealed Boolean @default(false)

  /// The room pseudonym each side had when they matched, snapshotted.
  ///
  /// NOT a lookup into `chat_group_members.anonymous_name`: that is keyed to the
  /// event's chat group, this row outlives the event, and the chat lifecycle
  /// sweeper deletes old groups — so a join would go null exactly when the
  /// history matters. A pair who match at two events would also have two
  /// different pseudonyms for one conversation.
  ///
  /// Null means the conversation did not come from a match (an accepted message
  /// request), and those keep real names throughout, as they always have.
  user1_pseudonym String?
  user2_pseudonym String?

  /// Set when the other side has asked this side to reveal.
  ///
  /// A boolean rather than a table, and that shape is the feature: asking twice
  /// writes the same `true`, so it cannot nag, and there is deliberately no
  /// "declined" state — a decline would deliver a rejection, which is the one
  /// thing this product exists to remove.
  user1_reveal_requested Boolean @default(false)
  user2_reveal_requested Boolean @default(false)

  /// The event whose room this pair matched in. Nullable for message-request
  /// conversations. FK-free on purpose: `events` outlives `chat_groups`, but a
  /// hard FK would still cascade a deleted event into losing the conversation.
  origin_event_id String? @db.Uuid

  /// Null while the conversation is live.
  ///
  /// Closing is a soft mark, never a delete. The row and its messages are
  /// retained because the person most motivated to erase a conversation is the
  /// one being reported in it — `message_reports.message_id` has no foreign
  /// key, so a hard delete leaves the report standing with its evidence gone
  /// and the admin queue unable to resolve an author.
  closed_at     DateTime? @db.Timestamptz(6)
  closed_by     String?
  /// 'unmatch' | 'block'. Metadata only — NOTHING branches on this. Room,
  /// socket and push filtering read `blocked_users`, which is reversible;
  /// this column is permanent, so keying a filter on it would leave someone
  /// hidden forever after they were unblocked.
  closed_reason String?

  user1    User               @relation("ConversationUser1", fields: [user1_id], references: [id], onDelete: Cascade)
  user2    User               @relation("ConversationUser2", fields: [user2_id], references: [id], onDelete: Cascade)
  messages private_messages[]

  @@unique([user1_id, user2_id])
  @@index([user1_id])
  @@index([user2_id])
  @@index([last_message_at])
  /// Every inbox read is "my live conversations", so both sides get the
  /// partial index rather than scanning and filtering.
  @@index([user1_id, closed_at])
  @@index([user2_id, closed_at])
}

/// Every profile photo we have looked at, and what we concluded.
///
/// Without this, "verified by construction" is a claim rather than a fact:
/// moderation degrades **open** (a vendor outage must not stop somebody having
/// a profile photo, the same call `lib/email.ts` makes), so a URL sitting in
/// `profiles.photos` might have been checked and passed, or might have arrived
/// during an outage. Those are different, and only one of them is safe to leave
/// alone.
///
/// Recording it makes failures retryable and the claim true. Keyed on the URL
/// rather than the user, because the same object survives being removed from a
/// profile and added back, and re-checking it would be work we already did.
/// Where people opened the app and found nothing.
///
/// Every time someone stands in a city we have not launched in, that is them
/// telling us where to go next — and until now the app noticed, said "nothing
/// here yet", and threw the fact away.
///
/// ## One row per person per city, not per open
///
/// The question this answers is "how many *people* are waiting in Saarbrücken",
/// and a log of opens cannot answer it: one enthusiast reopening the app fifty
/// times would outrank fifty separate people. The unique constraint is the
/// measurement, not an optimisation — `opens` is kept alongside because
/// intensity is interesting, but `count(*)` is the number that means something.
///
/// ## What is deliberately not here
///
/// No coordinates. City and country are what a launch decision needs, and
/// storing a per-open GPS trail of every user would be a far larger promise
/// about their privacy than this feature is worth. `city_key` is the normalised
/// form (`lib/address.ts`), so "Saarbrücken" and "saarbrucken " group as one.
///
/// Cascades on user deletion — someone who leaves takes their signal with them.
model city_demand {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String
  /// As shown to the user, so the dashboard can render a real place name.
  city       String
  /// Normalised for grouping. See `cityKey` in lib/address.ts.
  city_key   String
  country    String?
  first_seen DateTime @default(now()) @db.Timestamptz(6)
  last_seen  DateTime @default(now()) @db.Timestamptz(6)
  opens      Int      @default(1)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// The measurement: one row per person per city.
  @@unique([user_id, city_key])
  /// "where are people waiting" — the only query this table exists for.
  @@index([city_key])
}

model photo_checks {
  url        String   @id
  user_id    String
  /// false when the moderation call could not run — an outage, or no API key.
  /// These are the rows a sweeper would revisit.
  checked    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  /// "what still needs looking at" — the sweeper's query.
  @@index([checked, created_at])
}

model private_messages {
  id              String      @id @default(uuid()) @db.Uuid
  conversation_id String      @db.Uuid
  sender_id       String
  message_text    String?
  media_url       String?
  media_type      media_type?
  is_read         Boolean     @default(false)
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @default(now()) @db.Timestamptz(6)

  conversation private_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  sender       User                  @relation("PrivateMessageSender", fields: [sender_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([sender_id])
  @@index([created_at])
}

model event_rsvps {
  id         String      @id @default(uuid()) @db.Uuid
  event_id   String      @db.Uuid
  user_id    String
  status     rsvp_status @default(going)
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  updated_at DateTime    @default(now()) @db.Timestamptz(6)

  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([event_id, user_id])
  @@index([event_id])
  /// Promotion reads the oldest waitlisted person for one event.
  @@index([event_id, status, created_at])
  @@index([user_id])
}

// Enums
/// A physical place. Optional on an event and usually absent: most events are
/// at venues that are not on the platform, in which case events.venue_name
/// carries a free-text location and no venue owner has any rights.
///
/// `owner_id` null means unclaimed — the record exists (an admin created it, or
/// it was seeded) but nobody operates it yet.
model venues {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  address      String?
  city         String?
  latitude     Float?
  longitude    Float?
  capacity     Int?
  /// What kind of place this is. Nullable because venues predating this, and
  /// venues an admin adds in a hurry, should not be blocked on classifying.
  venue_type   venue_type?
  /// Extent + buffer for check-in, in the shape lib/geofence.ts understands.
  /// Events at this venue inherit it and may override per event — a rooftop
  /// event at a three-floor venue is a real case.
  geofence     Json?
  owner_id     String?
  owner_org_id String?      @db.Uuid
  claimed_at   DateTime?    @db.Timestamptz(6)
  status       venue_status @default(active)
  created_by   String?
  created_at   DateTime     @default(now()) @db.Timestamptz(6)
  updated_at   DateTime     @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at   DateTime?    @db.Timestamptz(6)

  // SetNull, not Cascade: removing an owner must orphan the venue, never delete
  // a real place and every event that happened in it.
  claims    venue_claims[]
  owner     User?          @relation("VenueOwner", fields: [owner_id], references: [id], onDelete: SetNull)
  owner_org organisations? @relation(fields: [owner_org_id], references: [id], onDelete: SetNull)
  events    events[]

  @@index([owner_id])
  @@index([owner_org_id])
  @@index([city])
  @@index([status])
  /// The Hotspots feed bounding-boxes on these. `events` has had the matching
  /// index since it shipped; this table did not, so the venue-proximity query
  /// was the one geo lookup in the product doing a scan.
  @@index([latitude, longitude])
}

/// A host: a company, or an individual operating as one.
///
/// Everything is an organisation, including a sole trader — a uniform shape
/// beats a user-or-org union at every call site. `kind` is what allows an
/// individual organiser to exist without a registered company: one member, no
/// GSTIN. A venue owner must be `company` with a legal name and GSTIN.
model organisations {
  id           String              @id @default(uuid()) @db.Uuid
  kind         organisation_kind   @default(individual)
  display_name String
  legal_name   String?
  /// Validated by checksum offline. There is no free official verification
  /// API — confirming a GSTIN is *registered* needs a paid provider.
  gstin        String?
  address      String?
  website      String?
  status       organisation_status @default(pending)
  /// May this organisation mark a broadcast as `sponsored`?
  ///
  /// An organisation-level flag rather than a role, because the permission
  /// belongs to the company with the commercial agreement -- not to whichever
  /// of its staff happens to be logged in.
  ///
  /// Off by default and granted by an admin. "Sponsored" is a claim that
  /// somebody paid; if everyone who can announce can also mark a message
  /// sponsored, the label stops meaning anything and becomes a styling choice.
  may_sponsor  Boolean             @default(false)
  verified_at  DateTime?           @db.Timestamptz(6)
  verified_by  String?
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  updated_at   DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  members        organisation_members[]
  events         events[]
  venues         venues[]
  domains        organisation_domains[]
  invites        organisation_invites[]
  join_requests  organisation_join_requests[]
  onboarding     organiser_onboarding_requests[]
  venue_claims   venue_claims[]
  eventClaims    event_claims[]
  sponsors       sponsors[]
  sponsor_claims sponsor_claims[]
  upload_grants  upload_grants[]

  @@index([status])
}

/// Who may act for an organisation. Membership, not identity, is what the
/// permission resolver reads — so a colleague gets the same access as whoever
/// created a thing, and the venue survives one person leaving.
model organisation_members {
  id                 String   @id @default(uuid()) @db.Uuid
  org_id             String   @db.Uuid
  user_id            String
  role               org_role @default(staff)
  is_primary_contact Boolean  @default(false)
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  org  organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([org_id, user_id])
  @@index([user_id])
  @@index([org_id])
}

/// A domain an organisation has proved it controls.
///
/// `@@unique([domain])` is the load-bearing line: without it two organisations
/// could each verify `bygbrewski.com`, and each would then auto-accept the
/// other's staff. First to verify wins; a second claim is refused and reviewed
/// by hand.
model organisation_domains {
  id                 String               @id @default(uuid()) @db.Uuid
  org_id             String               @db.Uuid
  /// Stored lowercase, apex only — `mail.acme.com` and `ACME.com` must not be
  /// two separate claims on the same company.
  domain             String
  method             domain_verify_method @default(dns_txt)
  /// The value that must appear in the TXT record. Kept after verification so
  /// a periodic re-check can confirm the record is still there.
  verification_token String
  verified_at        DateTime?            @db.Timestamptz(6)
  verified_by        String?
  created_at         DateTime             @default(now()) @db.Timestamptz(6)

  org organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@unique([domain])
  @@index([org_id])
}

/// An outstanding invitation to join an organisation.
///
/// The token is the sensitive surface — it grants access to a company's
/// dashboard — so only its SHA-256 hash is stored. A leaked database gives an
/// attacker hashes, not usable invitations.
model organisation_invites {
  id                     String    @id @default(uuid()) @db.Uuid
  org_id                 String    @db.Uuid
  /// Lowercased. The invite is bound to this address: accepting while signed in
  /// as anyone else is refused, so a forwarded link is not a way in.
  email                  String
  role                   org_role  @default(staff)
  token_hash             String
  expires_at             DateTime  @db.Timestamptz(6)
  invited_by             String
  accepted_at            DateTime? @db.Timestamptz(6)
  revoked_at             DateTime? @db.Timestamptz(6)
  /// Non-null when the invited address is outside the org's verified domain.
  /// Required in that case, and copied into audit_logs — an org that invites
  /// outsiders can do so, but not silently.
  domain_override_reason String?
  created_at             DateTime  @default(now()) @db.Timestamptz(6)

  org organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@unique([token_hash])
  @@index([org_id])
  @@index([email])
}

/// Someone on a verified domain asking to be let in.
///
/// The org's own admin decides, not the platform: a verified domain proves the
/// company owns the domain, not that every address on it should reach the
/// dashboard.
model organisation_join_requests {
  id         String              @id @default(uuid()) @db.Uuid
  org_id     String              @db.Uuid
  user_id    String
  status     join_request_status @default(pending)
  decided_by String?
  decided_at DateTime?           @db.Timestamptz(6)
  created_at DateTime            @default(now()) @db.Timestamptz(6)

  org  organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)
  user User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([org_id, user_id])
  @@index([org_id])
  /// The composite unique above leads with org_id, so it cannot serve the FK
  /// check that runs on every User delete.
  @@index([user_id])
}

/// A company applying to host on Blendn, before any account exists.
///
/// Deliberately not a `User` yet — an application is not an account, and
/// creating one on submit would let anyone mint dashboard logins. The row holds
/// what was claimed; approval is what creates the org, the user, and the
/// membership.
model organiser_onboarding_requests {
  id                String            @id @default(uuid()) @db.Uuid
  kind              organisation_kind @default(company)
  display_name      String
  legal_name        String?
  gstin             String?
  website           String?
  address           String?
  city              String?
  /// The person accountable. Every organisation has a human attached.
  contact_name      String
  contact_email     String
  contact_phone     String?
  /// Which dashboard role this application is for. A venue owner must be a
  /// company; an individual organiser may be a sole trader.
  requested_role    user_role         @default(organizer)
  email_verified_at DateTime?         @db.Timestamptz(6)
  /// Set at submit from the email domain. `domain` = company address, accepted
  /// as-is. `needs_proof` = free provider, must also carry GSTIN or a website.
  tier              onboarding_tier   @default(needs_proof)
  status            onboarding_status @default(pending)
  /// Shown to the reviewer, not enforced — the reviewer decides.
  review_note       String?
  reviewed_by       String?
  reviewed_at       DateTime?         @db.Timestamptz(6)
  decline_reason    String?
  /// Set on approval, linking the application to what it produced.
  org_id            String?           @db.Uuid
  created_at        DateTime          @default(now()) @db.Timestamptz(6)
  updated_at        DateTime          @default(now()) @updatedAt @db.Timestamptz(6)

  org organisations? @relation(fields: [org_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([contact_email])
  @@index([org_id])
}

/// The token for verifying an applicant's email, before they have an account.
/// Separate from `organisation_invites` because there is no org yet.
/// A password-reset token.
///
/// Mirrors `onboarding_email_tokens`: only the SHA-256 hash is stored, it is
/// single-use, and it expires. The TTL is deliberately shorter than the
/// onboarding one — an hour rather than a day — because this token changes a
/// credential rather than confirming an address, so a link sitting in an
/// inherited mailbox is worth much more to whoever finds it.
model password_reset_tokens {
  token_hash String    @id
  user_id    String
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

model onboarding_email_tokens {
  token_hash String    @id
  request_id String    @db.Uuid
  expires_at DateTime  @db.Timestamptz(6)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([request_id])
}

enum domain_verify_method {
  dns_txt
  email_role
}

enum join_request_status {
  pending
  approved
  declined
}

enum onboarding_tier {
  domain
  needs_proof
}

enum onboarding_status {
  pending
  email_pending
  approved
  declined
}

enum organisation_kind {
  individual
  company
}

enum organisation_status {
  pending
  verified
  suspended
}

enum org_role {
  owner
  admin
  staff
}

/// What kind of place a venue is.
///
/// There was no way to tell a restaurant from a stadium, which matters for
/// every question the product asks about a venue: what a sensible check-in
/// geofence looks like, what capacity is plausible, and what an organiser is
/// searching for. Grouped by the comments so the picker can present them in
/// sections rather than as a flat list of thirty.
/// A venue owner asserting a place is theirs.
///
/// Not data entry — owning a venue record means moderating other people's
/// events held there, so a claim is an **access request**. Nothing in the
/// evidence can be verified automatically (GSTIN is checksum-only and labelled
/// as such), so every claim is decided by a person, in the same queue shape as
/// organiser onboarding.
///
/// A claim against a venue that already has an owner is a `dispute`.
model venue_claims {
  id       String @id @default(uuid()) @db.Uuid
  venue_id String @db.Uuid
  /// The organisation that would own the venue, not the person filing.
  org_id   String @db.Uuid
  filed_by String

  status     venue_claim_status @default(pending)
  /// True when the venue already had an owner at filing time.
  is_dispute Boolean            @default(false)

  /// Checksum-validated only. The reviewer checks the registered address.
  gstin    String?
  /// Uploaded document URLs, keyed by kind (trade, fssai, liquor, photo).
  /// Free-shaped because the required set differs by venue type — a park has
  /// no FSSAI licence.
  evidence Json?

  reviewed_by   String?
  reviewed_at   DateTime? @db.Timestamptz(6)
  decision_note String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  venue venues        @relation(fields: [venue_id], references: [id], onDelete: Cascade)
  org   organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)

  /// One live claim per org per venue. Re-filing after a decline updates the
  /// row rather than stacking duplicates in the queue.
  @@unique([venue_id, org_id])
  @@index([status])
  @@index([venue_id])
  @@index([org_id])
}

/// A brand that appears at an event.
///
/// Deliberately `venues`-shaped, because it is the same problem: an organiser
/// may type a sponsor that has no account, exactly as they may type a venue not
/// on the platform. The real company claims it later and every placement
/// already attached comes with it, with no re-entry.
model sponsors {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  /// Lowercased, non-alphanumerics stripped. "Red Bull", "RedBull" and
  /// "red-bull" all collapse to `redbull`, which is the duplicate case the
  /// picker exists to catch. Written only by `normaliseSponsorName()`.
  ///
  /// A SEARCH key, never an identity: "AT&T" and "ATT" collapse together, and
  /// so would an unrelated three-letter brand. It drives the picker's "did you
  /// mean" and the per-org uniqueness index. It never auto-merges anything.
  name_key    String
  /// Null until claimed. SetNull, never Cascade — removing an owner must orphan
  /// the brand, not delete every placement it ever ran.
  org_id      String?        @db.Uuid
  logo_url    String?
  website     String?
  claimed_at  DateTime?      @db.Timestamptz(6)
  status      sponsor_status @default(active)
  /// Set when this row lost a merge. Reads exclude it; placements, campaigns
  /// and claims are repointed before it is set.
  merged_into String?        @db.Uuid
  created_by  String?
  created_at  DateTime       @default(now()) @db.Timestamptz(6)
  updated_at  DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  deleted_at  DateTime?      @db.Timestamptz(6)

  org        organisations?             @relation(fields: [org_id], references: [id], onDelete: SetNull)
  claims     sponsor_claims[]
  placements event_sponsors[]
  campaigns  event_sponsored_messages[]

  @@index([org_id])
  @@index([status])
  @@index([name_key])
}

/// One brand at one event. The placement object.
///
/// It has to exist to answer "may this sponsor post here", so hanging money on
/// it later is free rather than speculative.
///
///     organiser adds an UNCLAIMED brand      organiser adds a CLAIMED brand,
///     (nobody to ask)                        or a sponsor proposes
///            │                                        │
///            ▼                                        ▼
///        [ draft ] ──host publishes──> [ approved ]  [ proposed ] ──accept──> [ approved ]
///            │                              ▲             │
///            └──────────────────────────────┘             └──decline──> [ cancelled ]
///
/// An unclaimed brand has nobody to accept, and requiring one made the
/// organiser path decorative: the placement could never reach `approved`, so it
/// could never carry a message, so typing a sponsor name achieved nothing.
///
/// `live` and `ended` are NOT stored. They are derived from the event's own
/// timestamps by `placementPhase()`, so no sweeper can make the database
/// disagree with the clock.
model event_sponsors {
  id         String           @id @default(uuid()) @db.Uuid
  event_id   String           @db.Uuid
  sponsor_id String           @db.Uuid
  status     placement_status @default(draft)
  /// An organiser adding a brand and a sponsor buying in are the same row from
  /// opposite directions; audit needs to tell them apart.
  created_by String
  decided_by String?
  decided_at DateTime?        @db.Timestamptz(6)
  created_at DateTime         @default(now()) @db.Timestamptz(6)
  updated_at DateTime         @default(now()) @updatedAt @db.Timestamptz(6)

  event   events              @relation(fields: [event_id], references: [id], onDelete: Cascade)
  sponsor sponsors            @relation(fields: [sponsor_id], references: [id], onDelete: Cascade)
  /// Money lives on `placement_charges`, not here. A pricing correction must
  /// not rewrite the row that decides whether an ad may run.
  ///
  /// One-to-MANY on purpose. A placement has at most one LIVE charge, but a
  /// voided one stays for the record and a corrected one is raised beside it.
  /// Prisma cannot express "unique where status <> 'void'", so the constraint
  /// is a partial index in the migration and this side stays a list.
  charges placement_charges[]

  @@unique([event_id, sponsor_id])
  @@index([event_id])
  @@index([sponsor_id])
  @@index([status])
}

/// Mirrors `venue_claims`. Same reviewer, same evidence shape.
model sponsor_claims {
  id            String               @id @default(uuid()) @db.Uuid
  sponsor_id    String               @db.Uuid
  org_id        String               @db.Uuid
  filed_by      String
  status        sponsor_claim_status @default(pending)
  is_dispute    Boolean              @default(false)
  gstin         String?
  evidence      Json?
  reviewed_by   String?
  reviewed_at   DateTime?            @db.Timestamptz(6)
  decision_note String?
  created_at    DateTime             @default(now()) @db.Timestamptz(6)
  updated_at    DateTime             @default(now()) @updatedAt @db.Timestamptz(6)

  sponsor sponsors      @relation(fields: [sponsor_id], references: [id], onDelete: Cascade)
  /// Related, not a bare uuid. `venue_claims` relates its org and this must
  /// too, or an approved claim can reference an organisation that no longer
  /// exists.
  org     organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)

  /// One live claim per org per sponsor, matching the venue precedent. The
  /// stronger rule — one APPROVED claim per sponsor, whoever files it — is a
  /// partial unique index in the migration, because Prisma cannot express it.
  @@unique([sponsor_id, org_id])
  @@index([sponsor_id])
  @@index([org_id])
  @@index([status])
}

/// What a placement costs and whether the money arrived.
///
/// Deliberately NOT called an invoice. Calling it one in India drags in
/// sequential numbering, GSTIN on both parties, place-of-supply, a tax
/// breakdown and fiscal-year uniqueness — none of which are built, and all of
/// which become quietly wrong the moment someone treats the record as
/// authoritative. `organisations.gstin` already exists, which is exactly what
/// would make that gap plausible enough to be dangerous.
///
/// Separate from `event_sponsors` because a placement is an authorization fact
/// and a charge is a financial one. Merging them means a pricing correction
/// rewrites the row that decides whether an ad may run.
///
///     [draft] ──agree──> [agreed] ──settle──> [settled]
///        │                   │                    │
///        └───────────────────┴──void──> [void] <──┘
///
/// `amount_minor` and `currency` are IMMUTABLE once status leaves `draft`, and
/// no transition returns to draft. Enforced in `lib/sponsor-actions.ts` with a
/// test per illegal pair.
model placement_charges {
  id           String        @id @default(uuid()) @db.Uuid
  /// NOT @unique — see the partial index in the migration. A voided charge must
  /// not permanently prevent raising a correct one, which is the whole point of
  /// having `void` in the enum.
  placement_id String        @db.Uuid
  /// Minor units, integer. Never a float for money.
  amount_minor Int
  /// Constrained to the supported set, not free text: `VarChar(3)` alone
  /// accepts "XYZ". Totals are ALWAYS grouped by this column — summing minor
  /// units across currencies yields a number in no currency at all.
  currency     currency_code
  /// The same amount in the reporting currency, at `fx_rate` on `fx_date`.
  /// Lets one comparable total exist without pretending the original was in it.
  amount_base  Int?
  fx_rate      Decimal?      @db.Decimal(18, 8)
  fx_date      DateTime?     @db.Date
  status       charge_status @default(draft)
  priced_by    String
  agreed_at    DateTime?     @db.Timestamptz(6)
  settled_at   DateTime?     @db.Timestamptz(6)
  /// External reference. No payment provider is integrated.
  external_ref String?
  created_at   DateTime      @default(now()) @db.Timestamptz(6)
  updated_at   DateTime      @default(now()) @updatedAt @db.Timestamptz(6)

  /// Restrict, not SetNull: an orphan charge pointing at nothing is worse than
  /// a delete that refuses. Hard-deleting an event with a charged placement is
  /// therefore refused, deliberately — see the 409 in the admin delete route.
  placement event_sponsors @relation(fields: [placement_id], references: [id], onDelete: Restrict)
  /// "Who priced this" must stay answerable. A bare String id pointing at a
  /// deleted user is an audit trail that cannot be resolved.
  pricer    User           @relation("ChargePricer", fields: [priced_by], references: [id], onDelete: Restrict)

  @@index([placement_id])
  @@index([status])
  @@index([priced_by])
}

enum venue_claim_status {
  pending
  approved
  declined
}

/// Somebody saying "this event is mine".
///
/// The second instance of the venue-claim pattern, with two deliberate
/// differences, both forced by who files these.
///
/// **`org_id` is nullable.** A curated event's real organiser typically has no
/// account at all — that is the point of curating it — so a large share of
/// claims arrive from outside the platform. Those carry `onboarding_id`
/// instead, reusing `organiser_onboarding_requests` to create the organisation
/// the claim then needs. Exactly one of the two is set.
///
/// **Re-filing creates a new row.** `venue_claims` is `@@unique([venue_id,
/// org_id])` and updates in place, which keeps the queue tidy and hides how
/// many times somebody has asked. Here the count is the signal: a third claim
/// on one event is a reviewer's most useful fact, and it is exactly what an
/// upsert would erase.
model event_claims {
  id       String @id @default(uuid()) @db.Uuid
  event_id String @db.Uuid

  /// The organisation that would own the event. Null when the claimant has no
  /// account yet; `onboarding_id` carries the request that will create one.
  org_id        String? @db.Uuid
  /// The onboarding request this claim is waiting on. Null once `org_id` is set.
  onboarding_id String? @db.Uuid
  /// Null when filed by somebody with no account.
  filed_by      String?

  /// What the claimant filed from. The domain check reads this, so it is
  /// recorded even when an account exists and could have supplied one — the
  /// address that was used to claim is the fact a reviewer needs.
  contact_email String
  /// Free text from the claimant. Read by a human, never parsed.
  note          String?

  status event_claim_status @default(pending)

  /// What the automatic checks noticed, as a list of strings.
  ///
  /// Flags, never a decision. Nothing here auto-approves: approving hands a
  /// stranger the attendee list for an event, and `unclaimEvent` cannot un-see
  /// one. The venue queue's "does not have to be bulletproof, because auto-link
  /// is reversible" argument does not transfer.
  flags Json?

  reviewed_by   String?
  reviewed_at   DateTime? @db.Timestamptz(6)
  decision_note String?
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  event events         @relation(fields: [event_id], references: [id], onDelete: Cascade)
  org   organisations? @relation(fields: [org_id], references: [id], onDelete: Cascade)

  /// Three partial unique indexes live in SQL, because Prisma cannot express a
  /// `WHERE` on a unique. They are load-bearing, so they are named here:
  ///
  ///   event_claims_one_pending_per_org    (event_id, org_id)   WHERE pending
  ///   event_claims_one_pending_per_email  (event_id, email)    WHERE pending
  ///   event_claims_one_approved_per_event (event_id)           WHERE approved
  ///
  /// The third is the one that matters. `decideEventClaim` re-checks
  /// `claimRefusal` before its transaction, and a check outside a transaction
  /// is not a lock: two admins approving competing claims on one event both
  /// pass it. Only the database can serialise that, which is H13 in the
  /// register and the reason this is not left to the application.
  @@index([status])
  @@index([event_id])
  @@index([org_id])
}

/// Somebody stood at the door and was turned away.
///
/// ## Why this exists
///
/// A refused check-in used to produce a 400 and no record, which made a wrong
/// pin invisible until somebody complained -- and most people do not complain,
/// they leave. That matters most for curated events, where the pin was placed
/// by an admin who has never stood there, but it is the same blindness for an
/// organiser who drew their fence around the wrong building.
///
/// One small table answers three questions: is a pin wrong, is a fence too
/// tight, and how many people tried to get in and could not. The third is a
/// genuine product signal and nothing else measures it.
///
/// ## What it deliberately does not store
///
/// **No coordinates.** `shortfall_metres` is how far outside they were, which
/// is everything the diagnosis needs and cannot locate anybody. G11 found GPS
/// surviving account deletion on `event_check_ins`; adding a second table with
/// the same problem to fix the first would be absurd.
///
/// ## Retention (ER13)
///
/// Delete with the user. Rows are diagnostic, not evidence, and the aggregate a
/// curation reviewer reads -- counts per event -- survives the individual rows
/// going. Swept on the same 90-day window as the rest of the presence data.
model check_in_refusals {
  id            String  @id @default(uuid()) @db.Uuid
  event_id      String  @db.Uuid
  /// Which day, when the event has more than one. Null when none resolved.
  occurrence_id String? @db.Uuid
  user_id       String

  reason           refusal_reason
  /// Metres beyond the fence, buffer and accuracy allowance. Null unless the
  /// refusal was about distance -- an age refusal has no shortfall.
  shortfall_metres Int?
  /// What the device claimed. A cluster of refusals at poor accuracy is a
  /// different problem from a cluster at good accuracy, and only one of them is
  /// the pin's fault.
  accuracy_metres  Int?

  created_at DateTime @default(now()) @db.Timestamptz(6)

  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  /// The curation-health read: refusals per event, newest first.
  @@index([event_id, created_at])
  @@index([user_id])
}

enum refusal_reason {
  /// Outside the fence. The one that means the pin might be wrong.
  out_of_range
  /// No fence and no coordinates, so there was nothing to check against.
  no_geofence
  too_early
  too_late
  day_cancelled
  under_age
}

