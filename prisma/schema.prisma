// Sponsored chat messages (periodic, auto-sent)
model event_sponsored_messages {
  id               String    @id @default(uuid()) @db.Uuid
  event_id         String    @db.Uuid
  content          String
  interval_minutes Int       @default(30)
  is_active        Boolean   @default(false)
  last_sent_at     DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)

  /// Which brand this campaign is for.
  ///
  /// Nullable only so rows predating #259 (which have no brand) can exist. An
  /// ACTIVE campaign must have one: the due-select joins through it, so a null
  /// here means the campaign silently never sends. Enforced by a CHECK in the
  /// migration, not by hope.
  sponsor_id           String?                @db.Uuid
  /// The schedule, persisted.
  ///
  /// `setInterval` state died on every deploy: `start()` has no leading edge and
  /// `loadAll()` re-armed from zero on boot, so deploying twice in an evening
  /// meant a 30-minute campaign sent nothing. `last_sent_at` was written and
  /// never read.
  next_send_at         DateTime?              @db.Timestamptz(6)
  /// Set while a worker holds this row. Cleared on finalize. A row still
  /// claimed after the lease expires is retried, and the outbox unique on
  /// `sponsored_message_sends` makes that retry harmless.
  claim_token          String?                @db.Uuid
  claimed_at           DateTime?              @db.Timestamptz(6)
  consecutive_failures Int                    @default(0)
  deactivated_reason   String?
  /// The CURRENT creative's review state, denormalised onto the campaign.
  ///
  /// `sponsored_creatives` holds the history — every revision with its own
  /// verdict — but "may this run right now" is asked on every activation and
  /// every scheduler tick, and joining to find the latest revision to answer it
  /// would put a subquery on the hot path.
  ///
  /// Kept in step by `creativeEditPatch()`: an edit writes `pending` here in the
  /// SAME update that writes the new content, so there is no window where the
  /// words are new and the verdict is old.
  moderation_status    moderation_status_type @default(pending)

  event     events                    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  sponsor   sponsors?                 @relation(fields: [sponsor_id], references: [id], onDelete: SetNull)
  creatives sponsored_creatives[]
  sends     sponsored_message_sends[]

  @@index([event_id])
  @@index([is_active])
  @@index([sponsor_id])
}

/// One immutable revision of a campaign's copy and media.
///
/// The revision boundary already exists whether or not it is named: any edit
/// forces moderation back to `pending` and deactivates the campaign, so
/// "approved creative" is a distinct object. Naming it makes historical
/// reporting truthful — without it, editing the copy rewrites what every past
/// send is recorded as having shown, in a report a sponsor is billed against.
model sponsored_creatives {
  id                String                 @id @default(uuid()) @db.Uuid
  message_id        String                 @db.Uuid
  content           String
  media_url         String?
  media_type        String?
  /// SHA-256 from the storage layer plus the object version pinned at
  /// approval. NOT an ETag: an S3-compatible ETag is an MD5 only for
  /// single-part uploads and a hash-of-hashes for multipart, so it changes
  /// meaning with the upload strategy and is not a content identity.
  media_checksum    String?
  media_version_id  String?
  moderation_status moderation_status_type @default(pending)
  approved_by       String?
  approved_at       DateTime?              @db.Timestamptz(6)
  created_at        DateTime               @default(now()) @db.Timestamptz(6)

  message event_sponsored_messages  @relation(fields: [message_id], references: [id], onDelete: Cascade)
  sends   sponsored_message_sends[]

  @@index([message_id, created_at])
}

/// One fan-out. What the sponsor's report reads.
///
/// Relations are declared, not implied by a bare uuid: without them the table
/// accumulates orphans when a campaign is deleted and the report silently
/// counts sends whose campaign no longer exists.
model sponsored_message_sends {
  id                   String   @id @default(uuid()) @db.Uuid
  sponsored_message_id String   @db.Uuid
  /// Which revision actually ran. Editing the copy must not rewrite history.
  creative_id          String   @db.Uuid
  chat_message_id      String?  @db.Uuid
  /// Which tick this belongs to. Unique with the campaign, so a retry after a
  /// crash cannot produce a second row for the same window — the outbox insert
  /// is `ON CONFLICT DO NOTHING`.
  scheduled_for        DateTime @db.Timestamptz(6)
  sent_at              DateTime @default(now()) @db.Timestamptz(6)
  /// Active room members at send time. Summed across sends this is CUMULATIVE
  /// EXPOSURES, never "reach" — the same person recurs once per interval.
  members              Int
  /// Sockets in the room at send time. Labelled "live connected", not
  /// "delivered": push recipients, later reconnects and people scrolling back
  /// are all excluded.
  live_connected       Int
  /// Who was in the room, as a per-campaign HMAC — NEVER raw user ids.
  ///
  /// Raw ids would be a durable, per-timestamp attendance roster joined to a
  /// commercial entity. Two sends thirty minutes apart yield arrival and
  /// departure per person, and intersecting arrays across a campaign spanning
  /// several of one organiser's events identifies whoever attends everything —
  /// exactly the cross-event correlation `lib/pseudonym.ts:11-12` says a
  /// pseudonym exists to prevent. That file solved this once already, for
  /// exports; this reuses its shape.
  ///
  /// Salted per CAMPAIGN, which keeps `count(distinct)` exact — the only thing
  /// the report needs — while making the array useless for cross-campaign
  /// intersection and non-reversible without `NEXTAUTH_SECRET`.
  ///
  /// Emptied at event end, once reach is materialised onto the campaign. A
  /// campaign that ended has a number and no roster.
  ///
  /// **Never serialised to any client, export or CSV.**
  recipient_hashes     String[]

  message      event_sponsored_messages @relation(fields: [sponsored_message_id], references: [id], onDelete: Cascade)
  creative     sponsored_creatives      @relation(fields: [creative_id], references: [id], onDelete: Restrict)
  chat_message chat_messages?           @relation(fields: [chat_message_id], references: [id], onDelete: SetNull)

  @@unique([sponsored_message_id, scheduled_for])
  @@index([sponsored_message_id, sent_at])
  @@index([creative_id])
  /// Postgres indexes the REFERENCED side of a foreign key, never the
  /// referencing one. Without this, deleting a chat message — which the
  /// moderation path does — sequentially scans this whole table to find the
  /// SetNull targets, exactly as `chat_messages.parent_id` did before it was
  /// indexed. Caught by __tests__/integration/fk-indexes.itest.ts, which needs
  /// a real database and therefore only runs in CI.
  @@index([chat_message_id])
}

/// Every object we issued an upload for.
///
/// `isOurMediaUrl()` proves only that a hostname is ours, which says nothing
/// about who uploaded the bytes or what they are. This row is the difference
/// between "on our bucket" and "we issued this, to this org, with these limits".
model upload_grants {
  id           String    @id @default(uuid()) @db.Uuid
  user_id      String
  org_id       String    @db.Uuid
  /// The object key. Unique because one grant per object is the invariant, and
  /// stating it as a constraint beats implying it.
  key          String
  content_type String
  max_bytes    Int
  /// SHA-256, captured at validation and re-verified before every send. A
  /// content-addressed KEY is impossible with a presigned PUT — the key is
  /// chosen before the bytes exist — so immutability comes from the checksum
  /// and the pinned object version, not from the name.
  checksum     String?
  version_id   String?
  expires_at   DateTime  @db.Timestamptz(6)
  /// Set when a message actually references this object. Null AND expired is
  /// what the sweeper reclaims.
  consumed_at  DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  user User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  org  organisations @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@unique([key])
  /// The sweeper's predicate.
  @@index([expires_at])
  @@index([org_id])
  /// Same reason as `sponsored_message_sends.chat_message_id`: this cascades,
  /// so deleting a user scans every grant row to find theirs.
  @@index([user_id])
}

/// A poll carried by one chat message.
///
/// A poll is a message, not a sponsor feature — organisers get it too. Options
/// are rows rather than a JSON blob because votes reference them by id, and a
/// blob cannot be a foreign key.
model chat_polls {
  id              String    @id @default(uuid()) @db.Uuid
  message_id      String    @unique @db.Uuid
  question        String
  /// Defaults to the END OF THE EVENT, not the end of the room. The room opens
  /// before the event and closes after a feedback window, so "closes with the
  /// room" would leave a pre-event poll running for days.
  closes_at       DateTime? @db.Timestamptz(6)
  /// Hidden is the default: visible running totals bias later voters.
  ///
  /// Note this alone does NOT make a poll safe. Streaming counts while it is
  /// open is a timing oracle — everyone watching a room of four sees
  /// "0 → 1" the instant somebody votes, which is the same shape as the
  /// typing-indicator leak. With this false, counts emit only on close; with it
  /// true, they emit batched, never per-vote.
  results_visible Boolean   @default(false)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)

  message chat_messages       @relation(fields: [message_id], references: [id], onDelete: Cascade)
  options chat_poll_options[]
  votes   chat_poll_votes[]
}

model chat_poll_options {
  id       String @id @default(uuid()) @db.Uuid
  poll_id  String @db.Uuid
  label    String
  position Int

  poll  chat_polls        @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  votes chat_poll_votes[]

  @@unique([poll_id, position])
  /// Exists solely so `chat_poll_votes` can carry a COMPOSITE foreign key.
  /// Redundant with the primary key on its own; load-bearing as a target.
  @@unique([poll_id, id])
}

/// One vote per person per poll, enforced by the database.
///
/// `poll_id` is denormalised so `@@unique([poll_id, user_id])` can exist —
/// `(option_id, user_id)` would permit voting for every option in the same poll.
///
/// The composite foreign key is what makes that denormalisation safe. Without
/// it `poll_id` is an unvalidated free field: a row could claim poll A while its
/// `option_id` belongs to poll B, so the unique would guard a fiction — the user
/// has "voted in A" while their vote counts toward B, and can still vote in B
/// properly. Postgres refuses that row now rather than trusting every caller.
model chat_poll_votes {
  id         String   @id @default(uuid()) @db.Uuid
  poll_id    String   @db.Uuid
  option_id  String   @db.Uuid
  /// Exists SOLELY to enforce one vote per person. Never serialised to any
  /// client, socket payload, export or push notification. The room is
  /// pseudonymous and a vote is an opinion attached to a person.
  user_id    String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  poll   chat_polls        @relation(fields: [poll_id], references: [id], onDelete: Cascade)
  option chat_poll_options @relation(fields: [poll_id, option_id], references: [poll_id, id], onDelete: Cascade)
  user   User              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([poll_id, user_id])
  @@index([option_id])
  @@index([user_id])
}

// Announcement messages (instant, sent by organiser)
model event_announcements {
  id         String   @id @default(uuid()) @db.Uuid
  event_id   String   @db.Uuid
  content    String
  sent_by    String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  event  events @relation(fields: [event_id], references: [id], onDelete: Cascade)
  sender User   @relation(fields: [sent_by], references: [id], onDelete: Cascade)

  @@index([event_id])
  @@index([created_at])
  @@index([sent_by])
}

// Audit Logs
model audit_logs {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String?
  action      String
  resource    String
  resource_id String?
  details     Json?
  ip_address  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id])
  @@index([action])
  @@index([resource])
  @@index([created_at])
}

// Blocked Users
model blocked_users {
  id         String   @id @default(uuid()) @db.Uuid
  blocker_id String
  blocked_id String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  blocker User @relation("BlockedByUser", fields: [blocker_id], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedUser", fields: [blocked_id], references: [id], onDelete: Cascade)

  @@unique([blocker_id, blocked_id])
  @@index([blocker_id])
  @@index([blocked_id])
}

// Message Requests
model message_requests {
  id           String                 @id @default(uuid()) @db.Uuid
  sender_id    String
  recipient_id String
  status       message_request_status @default(pending)
  message      String?
  created_at   DateTime               @default(now()) @db.Timestamptz(6)
  updated_at   DateTime               @default(now()) @db.Timestamptz(6)
  responded_at DateTime?              @db.Timestamptz(6)

  sender    User @relation("MessageRequestSender", fields: [sender_id], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRequestRecipient", fields: [recipient_id], references: [id], onDelete: Cascade)

  @@unique([sender_id, recipient_id])
  @@index([recipient_id, status])
}

// ── Content Moderation ────────────────────────────────

enum moderation_status_type {
  pending
  approved
  rejected
}

enum moderation_source {
  auto_text
  auto_image
  auto_spam
  auto_keyword
  user_report
  manual
}

model moderation_flags {
  id            String                 @id @default(uuid()) @db.Uuid
  message_id    String                 @db.Uuid
  chat_group_id String                 @db.Uuid
  user_id       String
  source        moderation_source
  status        moderation_status_type @default(pending)
  categories    Json // e.g. {"hate": 0.92, "sexual": 0.1}
  confidence    Float
  auto_action   String? // "hidden" | "none" | "muted_user"
  reviewed_by   String?
  reviewed_at   DateTime?              @db.Timestamptz(6)
  review_notes  String?
  created_at    DateTime               @default(now()) @db.Timestamptz(6)

  message chat_messages @relation(fields: [message_id], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([status, created_at])
  @@index([chat_group_id])
  @@index([user_id])
  @@index([message_id])
}

/// A demo request from the organiser landing page.
///
/// Not an application. Applying for an account happens at `/apply` and has its
/// own tier gate and review queue (`organiser_onboarding_requests`); this is
/// someone asking for a walkthrough. The two stay separate tables and
/// cross-reference by email — merging them would put an unvetted marketing
/// contact into a queue that grants platform access.
model leads {
  id     String      @id @default(uuid()) @db.Uuid
  type   lead_type
  status lead_status @default(new)
  source String      @default("organizers-landing")

  /// Lowercased on write. The landing page lowercases too, but this is the
  /// side that has to be right — see lib/leads.ts.
  email        String
  /// Plus-addressing stripped (sam+2@x → sam@x), for abuse counting only.
  /// Never shown, never emailed; `email` is what a human contacts.
  email_root   String
  name         String?
  organization String?
  event_types  String?
  city         String?

  user_agent String?
  ip         String? @db.Inet

  /// Idempotency, scoped to leads that are still open. `"<type>:<email>"` while
  /// the lead is open, NULL once it is finished.
  ///
  /// A permanent UNIQUE(type, email) would show a visitor who returns months
  /// later a success they never got — the same silent-drop class this endpoint
  /// exists to prevent. A *partial* unique index expresses that exactly, but
  /// Prisma cannot declare one, so it would live only in migration SQL: present
  /// in production (`migrate deploy`) and absent in CI (`db push`). The
  /// duplicate test would then pass in prod and fail in CI for a real reason.
  ///
  /// A nullable unique column gets the same semantics — Postgres unique indexes
  /// permit unlimited NULLs — and both paths create it identically.
  open_key String? @unique

  assigned_to String?
  notes       lead_notes[]

  /// When the visitor pressed submit, as reported by the caller.
  submitted_at DateTime  @db.Timestamptz(6)
  /// When the row landed here. A gap between the two is the only evidence
  /// that ingest was failing and retrying.
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime  @updatedAt @db.Timestamptz(6)
  contacted_at DateTime? @db.Timestamptz(6)

  assignee User? @relation(fields: [assigned_to], references: [id], onDelete: SetNull)

  @@index([status, created_at(sort: Desc)])
  @@index([type, created_at(sort: Desc)])
  @@index([email])
  @@index([email_root, created_at])
  @@index([assigned_to])
}

/// Append-only. "Called, no answer" and "called again, keen" are both worth
/// keeping; a single overwritable field loses the first one.
model lead_notes {
  id         String   @id @default(uuid()) @db.Uuid
  lead_id    String   @db.Uuid
  author_id  String
  body       String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  lead   leads @relation(fields: [lead_id], references: [id], onDelete: Cascade)
  author User  @relation(fields: [author_id], references: [id], onDelete: Cascade)

  @@index([lead_id, created_at])
  @@index([author_id])
}

/// One value today. An enum so adding a kind is a migration rather than a
/// free-text column that quietly accumulates typos.
enum lead_type {
  demo_request
}

enum lead_status {
  new
  contacted
  qualified
  converted
  archived
  spam
}

/// A live-ops alert that outlives the tab it was computed in.
///
/// `deriveAlerts` is pure and correct and ran in a browser `useMemo`, so seven
/// rules produced warnings that existed only while somebody had the live tab
/// open. An `over_capacity` breach at 23:40 was gone at 23:45 with no record
/// that it had happened — on the screen a venue's crowd-safety decisions are
/// supposed to come from.
///
/// The rule function is unchanged and now has a second caller on a timer. This
/// table is its memory.
model event_issues {
  id            String    @id @default(uuid()) @db.Uuid
  event_id      String    @db.Uuid
  /// Which day of a run. Null for an event with no resolvable occurrence,
  /// which is the same fallback occupancy uses.
  occurrence_id String?   @db.Uuid
  /// A `LiveAlertKind`. Deliberately a string rather than an enum: the rules
  /// live in `lib/live-metrics.ts` and adding one should not need a migration
  /// before the rule can be tried.
  kind          String
  severity      String
  /// The wording as it fired. Kept rather than re-derived, because the rule may
  /// be edited afterwards and the record should say what the organiser was
  /// actually told.
  title         String
  body          String

  opened_at    DateTime  @default(now()) @db.Timestamptz(6)
  /// Bumped while the condition persists, so a two-hour queue is one issue with
  /// a duration rather than a hundred rows.
  last_seen_at DateTime  @default(now()) @db.Timestamptz(6)
  /// The condition stopped. Not the same as somebody dealing with it.
  resolved_at  DateTime? @db.Timestamptz(6)

  /// Somebody saw it. Distinct from resolved on purpose: an alert that cleared
  /// itself and one a human acted on are different facts, and the second is the
  /// one worth asking about afterwards.
  acknowledged_at DateTime? @db.Timestamptz(6)
  acknowledged_by String?

  event events @relation(fields: [event_id], references: [id], onDelete: Cascade)

  /// The live read: what is open for this event, newest first.
  @@index([event_id, resolved_at, opened_at])
  ///
  /// NOTE: the invariant that matters is NOT here, because `schema.prisma`
  /// cannot express it: at most one OPEN issue per event, occurrence and kind,
  /// as a partial unique WHERE `resolved_at IS NULL`. It lives in the migration
  /// SQL. Without it a sweep on a timer writes one row per pass, and a queue
  /// lasting an hour becomes sixty identical alerts.
}
