# Copy to .env and fill in. Names here match what the code actually reads —
# see lib/env.ts for the validated schema.
#
# Production boots fail fast if any REQUIRED value is missing or malformed
# (server.ts calls validateEnv before binding), so a bad value here is a failed
# deploy rather than a broken runtime.

# ── Required ──────────────────────────────────────────

# Postgres. Only DATABASE_URL is needed — Prisma's directUrl is for setups where
# the app talks to a connection pooler and migrations need to bypass it. Railway
# Postgres is a direct connection, so a second URL would just be the same string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blendn

# Full origin of this deployment. Also part of the CORS allow-list in
# middleware.ts and lib/socket-server.ts.
NEXTAUTH_URL=http://localhost:3000

# Both must be at least 32 characters. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
MOBILE_JWT_SECRET=

# Bearer token for /api/cron/*. The endpoint fails closed — every request is
# rejected while this is unset, so scheduled jobs will not run without it.
CRON_SECRET=

# ── Object storage (optional) ─────────────────────────
# Tigris, via the AWS S3 SDK. Uploads are silently disabled when these are
# unset: lib/tigris.ts isConfigured() returns false and presigned-url requests
# get a 503. Note these are TIGRIS_*, not AWS_*.

TIGRIS_ENDPOINT=https://fly.storage.tigris.dev
TIGRIS_ACCESS_KEY=
TIGRIS_SECRET_KEY=
TIGRIS_BUCKET=blendn-media
TIGRIS_REGION=auto

# ── Moderation (optional) ─────────────────────────────
# Without this the moderation pipeline degrades to keyword matching only —
# no OpenAI text or image checks. It fails quiet, so an unset key in a new
# environment looks like working moderation until something gets through.

OPENAI_API_KEY=

# ── OAuth (optional) ──────────────────────────────────
# Needed only for the matching sign-in method.

GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Audience for Apple identity tokens. Defaults to com.matryxsociallabs.blendn.
APPLE_BUNDLE_ID=

# ── Observability (optional) ──────────────────────────
# Sentry is disabled entirely without a DSN. SENTRY_AUTH_TOKEN is build-time
# only, for source map upload — without it the build still succeeds but
# production stack traces stay minified.

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Runtime (optional) ────────────────────────────────

# debug | info | warn | error. Defaults to info.
LOG_LEVEL=info
PORT=3000
