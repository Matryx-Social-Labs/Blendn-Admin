# Copy to .env and fill in. Names here match what the code actually reads —
# see lib/env.ts for the validated schema.
#
# Production boots fail fast if any REQUIRED value is missing or malformed
# (server.ts calls validateEnv before binding), so a bad value here is a failed
# deploy rather than a broken runtime.

# ── Required ──────────────────────────────────────────

# Postgres. Locally only DATABASE_URL is needed. Railway Postgres is a direct
# connection, so there is no pooler URL (Prisma's directUrl) either.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blendn
# Deployed, DATABASE_URL is the app role `blendn_app` (rows only, no DDL) and this
# is the owner role, which `prisma migrate deploy` uses (prisma.config.ts).
# Unset: migrations use DATABASE_URL.
# MIGRATE_DATABASE_URL=

# Full origin of this deployment. Also part of the CORS allow-list in
# middleware.ts and lib/socket-server.ts. Set this to the dashboard host once
# the two below are in use — it is what login redirects and every email link
# resolve against.
NEXTAUTH_URL=http://localhost:3000

# Serve the dashboard and the mobile API on separate hostnames. Both must be
# set or the split is skipped entirely, so a single-host deployment leaves them
# unset (as here). Bare hostnames, no scheme and no port — middleware.ts
# compares them against the Host header.
#
#   DASHBOARD_HOST=dashboard.blendn.app
#   API_HOST=api.blendn.app
#
# /dashboard and /login on the API host redirect to the dashboard host, because
# people follow links and our own notification emails point there. /api/mobile
# on the dashboard host is refused outright — that is a misconfigured client,
# not a stale bookmark.
#
# Set these only after the dashboard host serves a valid certificate. Turning
# the split on first means the redirect sends you to a host the browser
# refuses, and the dashboard becomes unreachable on both names.
DASHBOARD_HOST=
API_HOST=

# Both must be at least 32 characters. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
MOBILE_JWT_SECRET=

# Bearer token for /api/cron/*. The endpoint fails closed — every request is
# rejected while this is unset, so scheduled jobs will not run without it.
CRON_SECRET=

# ── Object storage (optional) ─────────────────────────
# Tigris, via the AWS S3 SDK. Uploads are silently disabled when these are
# unset: lib/tigris.ts isConfigured() returns false and presigned-url requests
# get a 503. Note these are TIGRIS_*, not AWS_*.

TIGRIS_ENDPOINT=https://fly.storage.tigris.dev
TIGRIS_ACCESS_KEY=
TIGRIS_SECRET_KEY=
TIGRIS_BUCKET=blendn-media
TIGRIS_REGION=auto

# Comma-separated ISO country codes the venue address search is limited to.
# Empty means worldwide. Defaults to India, where the product launches — an
# organiser outside it gets no search results and no explanation, so this is
# the knob rather than a code change.
GEOCODE_COUNTRY_CODES=in

# ── Moderation ─────────────────────────────────────────
# The OpenAI moderation checks. Required on Railway production (boot refuses
# without it); elsewhere the server boots with a warning.
OPENAI_API_KEY=
# The mood classifier's chat model. Unset: gpt-6-luna (lib/env.ts). It is sent
# reasoning_effort "none" and no temperature, so the model must accept that.
# SENTIMENT_MODEL=

# ── OAuth (optional) ──────────────────────────────────
# Needed only for the matching sign-in method.
#
# GOOGLE_WEB_CLIENT_ID is required for Google sign-in from *any* platform,
# including iOS and Android. The native SDK sends the web ("server") client id
# to Google as the token audience, so the id token that reaches us carries the
# web id in `aud` — not the iOS or Android one. Setting only the native ids
# means every Google sign-in is rejected on the audience check. Production ran
# that way; the server now warns about it at boot.

GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# The DASHBOARD's own Google web client: platform staff (app_admin, company
# Google Workspace only) sign in to the dashboard with it. Not the mobile
# client above. Both or neither; unset = no Google button on /login.
# Redirect URI to register: <NEXTAUTH_URL>/api/auth/callback/google
DASHBOARD_GOOGLE_CLIENT_ID=
DASHBOARD_GOOGLE_CLIENT_SECRET=
# true: admins may not use a dashboard password and get no reset mail; they
# use Google. Needs the two above or boot fails. Unset everywhere until the
# client exists; unsetting it is the break-glass.
# ADMIN_SSO_REQUIRED=true

# Audience for Apple identity tokens, and the Sign in with Apple client id.
# Defaults to com.matryxsociallabs.blendn.
APPLE_BUNDLE_ID=
# Sign in with Apple revoke on account deletion (App Store 5.1.1(v)). A key with
# Sign in with Apple enabled: Team ID, Key ID, and the .p8 contents (literal \n
# is fine). Unset: deletion still deletes; the skipped revoke is audited.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# App Review aid, OFF unless set (DEPLOYMENT.md § 7). Comma-separated USER IDS
# (never emails) from `npm run seed:review`.
REVIEW_ACCOUNT_IDS=

# ── Rate limiting (optional, but not free to skip) ────
# Without this, rate-limit counters (lib/rate-limit-store.ts) live in an
# in-process Map instead of Redis — correct on one replica, but every limit
# (including /api/mobile/auth/signin) silently becomes per-instance the
# moment Railway runs more than one, weakening brute-force protection with
# no error anywhere. Set this in any environment that scales beyond one replica.

REDIS_URL=

# `1` attaches the Socket.io Redis adapter, for a second replica only (with
# sticky sessions and one owner of the ops loop: lib/socket-server.ts). Leave
# unset at one replica: with it, a Redis restart freezes every room emit.
SOCKET_REDIS_ADAPTER=

# ── Blendn+ (optional; docs/IAP-SETUP.md) ─────────────
# RevenueCat's webhook sends `Authorization: Bearer <this>`. 32+ characters.
# Unset: no store purchase grants Blendn+.
REVENUECAT_WEBHOOK_SECRET=
# RevenueCat's secret API key (sk_…): confirms a TRANSFER before anything moves,
# and deletes an erased account there. Unset: transfers move nothing.
REVENUECAT_SECRET_KEY=
# Gated cities and the day each flipped (Bengaluru:2026-11-01), or *:<date>.
# Unset: launch season everywhere, every Plus feature is everyone's.
PLUS_GATING=

# ── Observability (optional) ──────────────────────────
# Sentry is disabled entirely without a DSN. SENTRY_AUTH_TOKEN is build-time
# only, for source map upload — without it the build still succeeds but
# production stack traces stay minified.

NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# ── Runtime (optional) ────────────────────────────────

# debug | info | warn | error. Defaults to info.
LOG_LEVEL=info
PORT=3000

# ── Public share pages (Flow 16) ──────────────────────
# Shared with the landing site (same value in its Vercel env). 32+ characters.
# Lets the landing name the visitor it forwards, for the per-network rate limit.
# Unset: callers are limited by their own address. Leave the line out, or
# give it 32+ characters: a SET but empty or short value fails validateEnv
# and production does not boot.
# SHARE_PROXY_SECRET=

# The public site the server's links point at (door QR, friend/crew links,
# mail). Bare https origin, no trailing slash. Unset = https://www.blendn.app.
# Staging: https://staging.blendn.app. Production: unset (anything but www fails boot).
# PUBLIC_SITE_ORIGIN=

# Whether the store listings are public yet. When true, the reset-password page
# for an attendee offers them beside "Open Blend'n". Same names as the landing page.
APP_STORE_LISTED=
PLAY_LISTED=
