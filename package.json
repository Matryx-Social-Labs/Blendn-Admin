{
  "name": "blendn-admin",
  "version": "0.48.0",
  "private": true,
  "scripts": {
    "dev": "ts-node -r tsconfig-paths/register --project tsconfig.server.json server.ts",
    "dev:next": "next dev",
    "build": "next build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server.js",
    "start:next": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts",
    "postinstall": "prisma generate",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:integration": "jest --config jest.integration.config.ts",
    "smoke": "tsx scripts/smoke.ts",
    "bench": "tsx scripts/bench.ts",
    "seed:volume": "tsx scripts/seed-volume.ts"
  },
  "prisma": {
    "seed": "npx ts-node --compiler-options '{\"module\":\"CommonJS\"}' prisma/seed.ts"
  },
